      "properties": {
        "headline": {
          "const": "Team chat that runs on your devices."
        },
        "bodyCopySha256": {
          "const": "2db41bdb5926d7968600052a638be5b5c6b5ee614013a8e2bbe7c3202693ac3b"
        },
        "primaryAction": {
          "const": "Download Chaft"
        },
        "secondaryAction": {
          "const": "Read the docs"
        },
        "sourceAction": {
          "const": "Explore the source"
        },
        "securityCopy": {
          "const": "Unaudited software. Not for sensitive or production communication."
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bodyCopy",
            "headingsNavigationButtonsAndLabels"
