              "const": "Space Grotesk"
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentPath",
        "productionWorker",
        "productionDomains",
        "productionMustRemainUnchanged",
        "workersDevEnabled",
        "cloudflarePreviewUrlsEnabled"
      ],
      "properties": {
        "componentPath": {
          "const": "cloudflare/website-previews/component.yaml"
        },
        "productionWorker": {
          "const": "chaft-website"
        },
        "productionDomains": {
          "const": [
            "chaft.ai",
            "www.chaft.ai"
          ]
        },
        "productionMustRemainUnchanged": {
          "const": true
        },
        "workersDevEnabled": {
          "const": false
        },
        "cloudflarePreviewUrlsEnabled": {
          "const": false
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/hero1"
        },
        {
          "$ref": "#/$defs/hero2"
        },
        {
          "$ref": "#/$defs/hero3"
        },
        {
          "$ref": "#/$defs/hero4"
        }
      ],
      "items": false
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selectedSlot",
        "decisionRecord",
        "productionRevision"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-started",
            "reviewing",
            "selected",
            "promoted",
            "closed"
          ]
        },
        "selectedSlot": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "hero-1",
                "hero-2",
                "hero-3",
                "hero-4"
              ]
            }
          ]
        },
        "decisionRecord": {
          "type": [
            "null",
            "string"
          ]
        },
        "productionRevision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "slotStatus": {
      "enum": [
