{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaft.ai/schemas/landing-hero-preview-cycle.schema.json",
  "title": "Chaft landing-page hero Preview cycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "systemName",
    "name",
    "title",
    "status",
    "baseRevision",
    "sourceDesign",
    "runtimeEnvironment",
    "invariants",
    "governance",
    "slots",
    "selection"
  ],
  "properties": {
    "$schema": {
      "const": "./preview-cycle.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "systemName": {
      "const": "Chaft Previews"
    },
    "name": {
      "const": "landing-hero"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "foundation",
        "ready",
        "active",
        "review",
        "selected",
        "closed"
      ]
    },
    "baseRevision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      ]
    },
    "sourceDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileUrl",
        "sourceSectionNodeId",
        "sourceSectionUrl",
        "observedLastModifiedAt",
        "referenceSnapshot",
        "note"
      ],
      "properties": {
        "fileUrl": {
          "const": "https://www.figma.com/design/hDvRvY0J6fna6OTWWlC639/Josh-s-Chaft"
        },
        "sourceSectionNodeId": {
          "const": "164:75"
        },
        "sourceSectionUrl": {
          "const": "https://www.figma.com/design/hDvRvY0J6fna6OTWWlC639/Josh-s-Chaft?node-id=164-75"
        },
        "observedLastModifiedAt": {
          "const": "2026-07-30T11:13:58Z"
        },
        "referenceSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalization",
            "sha256"
          ],
          "properties": {
            "canonicalization": {
              "const": "chaft-preview-figma-reference-v1"
            },
            "sha256": {
              "const": "29188bdcbc245e12efe0af21ac3f58dc023763c6b61e29c82b2d7337bef99de5"
            }
          }
        },
        "note": {
          "const": "Reviewed reference snapshot of the linked Figma section, visual nodes, prompt nodes, and prompt text. The digest binds this repository record; the Figma links themselves remain mutable."
        }
      }
    },
    "runtimeEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentModeName",
        "deploymentModeValue",
        "branchName",
        "siteUrlName"
      ],
      "properties": {
        "deploymentModeName": {
          "const": "CHAFT_DEPLOYMENT_MODE"
        },
        "deploymentModeValue": {
          "const": "preview"
        },
        "branchName": {
          "const": "CHAFT_PREVIEW_BRANCH"
        },
        "siteUrlName": {
          "const": "SITE_URL"
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "bodyCopySha256",
        "primaryAction",
        "secondaryAction",
        "sourceAction",
        "securityCopy",
        "typography"
