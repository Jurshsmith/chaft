---
import { getImage } from "astro:assets";

import mark from "../../../desktop-qt/resources/branding/chaft-mark.png";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  PREVIEW_ROBOTS_POLICY,
  PRODUCTION_ORIGIN,
  previewSlotLabel,
  resolveWebsiteDeployment,
} from "../lib/preview-contract.mjs";
import { sitePath } from "../lib/site-path";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, structuredData } = Astro.props;
const siteName = "Chaft";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const socialTitle =
  title === siteName
    ? "Chaft — Open-source team chat that runs on your devices."
    : fullTitle;
const deployment = resolveWebsiteDeployment({
  deploymentMode: process.env.CHAFT_DEPLOYMENT_MODE,
  previewBranch: process.env.CHAFT_PREVIEW_BRANCH,
  siteUrl: process.env.SITE_URL ?? Astro.site ?? Astro.url,
});
const canonicalBase = deployment.isPreview
  ? new URL(PRODUCTION_ORIGIN)
  : Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, canonicalBase);
const socialImage = new URL(sitePath("/og-chaft-v3.png"), canonicalBase);
const socialImageAlt =
  "Chaft logo beside a peer network and the message: Team chat that runs on your devices.";
const favicon = await getImage({ src: mark, width: 64, height: 64, format: "png" });
const chillaxStylesheet =
  "https://api.fontshare.com/v2/css?f[]=chillax@400,500,600,700&display=swap";
const robotsPolicy = deployment.isPreview
  ? PREVIEW_ROBOTS_POLICY
  : noindex
    ? "noindex, nofollow"
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1e8" />
    <meta name="description" content={description} />
    {robotsPolicy && <meta name="robots" content={robotsPolicy} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={favicon.src} sizes="64x64" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin="anonymous" />
    <link rel="stylesheet" href={chillaxStylesheet} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <slot name="head" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {deployment.preview && (
      <aside
        class="chaft-preview-badge"
        aria-label={`Chaft Preview slot ${deployment.preview.slot}`}
      >
        <strong>Chaft Preview</strong>
        <span aria-hidden="true">·</span>
        <span>{previewSlotLabel(deployment.preview.slot)}</span>
      </aside>
    )}
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    {deployment.isPreview && (
      <style is:inline>
        {`
          .chaft-preview-badge {
            position: fixed;
            right: max(0.75rem, env(safe-area-inset-right));
            bottom: max(0.75rem, env(safe-area-inset-bottom));
            z-index: 40;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            max-width: calc(100vw - 1.5rem);
            padding: 0.45rem 0.65rem;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-sm);
            background: var(--surface-raised);
            box-shadow: 3px 3px 0 rgb(23 33 31 / 14%);
            color: var(--text-soft);
            font-family: var(--font-ui);
            font-size: 0.72rem;
            line-height: 1.2;
          }

          .chaft-preview-badge strong {
            color: var(--text-strong);
            font-weight: 500;
          }
        `}
      </style>
    )}
  </body>
</html>
