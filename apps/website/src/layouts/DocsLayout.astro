---
import type { MarkdownHeading } from "astro";

import DocsBreadcrumbs from "../components/docs/DocsBreadcrumbs.astro";
import DocsPager from "../components/docs/DocsPager.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import DocsStatus from "../components/docs/DocsStatus.astro";
import DocsTableOfContents from "../components/docs/DocsTableOfContents.astro";
import type { DocNavigationEntry } from "../lib/docs";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  section: string;
  status: string;
  audience: string;
  currentId: string;
  docs: DocNavigationEntry[];
  headings: MarkdownHeading[];
  previous?: DocNavigationEntry | undefined;
  next?: DocNavigationEntry | undefined;
}

const {
  title,
  description,
  section,
  status,
  audience,
  currentId,
  docs,
  headings,
  previous,
  next,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="docs-page">
    <div class="shell docs-page__grid">
      <DocsSidebar entries={docs} currentId={currentId} />

      <article class="docs-article">
        <DocsBreadcrumbs section={section} title={title} isIndex={currentId === "index"} />
        <DocsStatus section={section} status={status} audience={audience} />
        <DocsTableOfContents headings={headings} />
        <div class="docs-prose">
          <slot />
        </div>
        <DocsPager previous={previous} next={next} />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .docs-page {
    min-height: 70vh;
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(4rem, 9vw, 7rem);
  }

  .docs-page__grid {
    display: grid;
    grid-template-columns: minmax(12.5rem, 14rem) minmax(0, 48rem);
    gap: clamp(2.25rem, 6vw, 5rem);
    justify-content: start;
    align-items: start;
  }

  .docs-article {
    min-width: 0;
    padding-bottom: 2rem;
  }

  .docs-article > :global(.docs-status) {
    margin-bottom: 1.35rem;
  }

  .docs-prose {
    max-width: 66ch;
  }

  .docs-prose :global(h1) {
    max-width: 18ch;
    margin-bottom: 1.35rem;
    font-size: clamp(2.55rem, 5vw, 3.85rem);
    overflow-wrap: anywhere;
  }

  .docs-prose :global(h2),
  .docs-prose :global(h3) {
    max-width: 28ch;
    scroll-margin-top: 1.5rem;
  }

  .docs-prose :global(h2) {
    margin-block: 3.75rem 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    font-size: clamp(1.65rem, 3vw, 2.15rem);
  }

  .docs-prose :global(h3) {
    margin-block: 2.35rem 0.75rem;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
  }

  .docs-prose :global(h1 + p) {
    color: var(--text-soft);
    font-size: clamp(1.08rem, 1.8vw, 1.22rem);
    line-height: 1.7;
  }

  .docs-prose :global(p),
  .docs-prose :global(li) {
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.72;
  }

  .docs-prose :global(p),
  .docs-prose :global(ul),
  .docs-prose :global(ol),
  .docs-prose :global(blockquote),
  .docs-prose :global(pre),
  .docs-prose :global(table) {
    margin-block: 0 1.25rem;
  }

  .docs-prose :global(ul),
  .docs-prose :global(ol) {
    padding-left: 1.4rem;
  }

  .docs-prose :global(li + li) {
    margin-top: 0.4rem;
  }

  .docs-prose :global(strong) {
    color: var(--text-strong);
    font-weight: 500;
  }

  .docs-prose :global(a) {
    color: var(--accent);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .docs-prose :global(code) {
    padding: 0.12em 0.32em;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    background: var(--surface-deep);
    color: var(--text-strong);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .docs-prose :global(pre) {
    max-width: 100%;
    overflow: auto;
    padding: 1rem 1.1rem;
    border: 1px solid var(--surface-ink);
    border-radius: var(--radius-sm);
    background: var(--surface-ink);
    box-shadow: 5px 6px 0 rgb(23 33 31 / 10%);
    line-height: 1.55;
  }

  .docs-prose :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
    color: #e8eee9;
    font-size: 0.8rem;
  }

  .docs-prose :global(blockquote) {
    padding: 1.15rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--accent) 34%, var(--border-subtle));
    border-left: 4px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--secure-surface);
  }

  .docs-prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .docs-prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .docs-prose :global(th),
  .docs-prose :global(td) {
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    text-align: left;
    vertical-align: top;
  }

  .docs-prose :global(th) {
    background: var(--surface-raised);
    color: var(--text-strong);
    font-weight: 500;
  }

  .docs-prose :global(td) {
    font-family: var(--font-body);
  }

  .docs-prose :global(table a) {
    word-break: normal;
    overflow-wrap: normal;
  }

  .docs-prose :global(hr) {
    margin-block: 3rem;
    border: 0;
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 900px) {
    .docs-page__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
