---
import { getCollection, render } from "astro:content";

import DocsLayout from "../../layouts/DocsLayout.astro";
import { sortPublishedDocs } from "../../lib/docs";

export const prerender = true;

const docs = sortPublishedDocs(await getCollection("docs"));
const doc = docs.find((entry) => entry.id === "index");

if (!doc) {
  throw new Error("The published documentation index is missing.");
}

const { Content, headings } = await render(doc);
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  section={doc.data.section}
  status={doc.data.status}
  audience={doc.data.audience}
  currentId={doc.id}
  docs={docs}
  headings={headings}
>
  <Content />
</DocsLayout>
