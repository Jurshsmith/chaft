---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";

import DocsLayout from "../../layouts/DocsLayout.astro";
import { docNeighbors, docRoutePath, sortPublishedDocs } from "../../lib/docs";

export const prerender = true;

export async function getStaticPaths() {
  const docs = sortPublishedDocs(await getCollection("docs"));
  return docs
    .filter((entry) => entry.id !== "index")
    .map((entry) => ({
      params: {
        slug: docRoutePath(entry.id).slice("/docs/".length, -1),
      },
      props: { doc: entry },
    }));
}

interface Props {
  doc: CollectionEntry<"docs">;
}

const { doc } = Astro.props;
const docs = sortPublishedDocs(await getCollection("docs"));
const { Content, headings } = await render(doc);
const { previous, next } = docNeighbors(docs, doc.id);
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  section={doc.data.section}
  status={doc.data.status}
  audience={doc.data.audience}
  currentId={doc.id}
  docs={docs}
  headings={headings}
  previous={previous}
  next={next}
>
  <Content />
</DocsLayout>
