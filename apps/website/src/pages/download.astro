---
import DownloadGrid from "../components/DownloadGrid.astro";
import ReleaseSafetyNotice from "../components/ReleaseSafetyNotice.astro";
import { currentRelease } from "../data/releases";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/site-path";

const description =
  "Download the Chaft desktop preview for Windows, macOS, or Linux, with checksums and release evidence.";
const hasPublishedDownloads = currentRelease.assets.some((asset) => asset.available);
const publishedDate = currentRelease.publishedAt
  ? new Intl.DateTimeFormat("en", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    }).format(new Date(currentRelease.publishedAt))
  : "Not published";
---

<BaseLayout title="Download" description={description}>
  <section class="download-hero" aria-labelledby="download-title">
    <div class="shell download-hero__layout">
      <div>
        <p class="eyebrow">Desktop preview</p>
        <h1 id="download-title">Download Chaft.</h1>
        <p class="lede">
          Choose a package for Windows, macOS, or Linux. Architecture,
          checksum, and build evidence stay attached to every download.
        </p>
      </div>

      <aside class="current-release" aria-label="Current release">
        <span class="status">
          {hasPublishedDownloads ? "Available" : "Packages pending"}
        </span>
        <div>
          <span>Current canary</span>
          <strong>v{currentRelease.version}</strong>
        </div>
        <dl>
          <div><dt>Published</dt><dd>{publishedDate}</dd></div>
          <div><dt>Platforms</dt><dd>Windows · macOS · Linux</dd></div>
        </dl>
        <a href={sitePath(`/releases/${currentRelease.version}/`)}>
          View release details <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>

  <section class="download-platforms" id="platforms" aria-labelledby="platforms-title">
    <div class="shell">
      <div class="platforms-heading">
        <div>
          <p class="eyebrow">Early build</p>
          <h2 id="platforms-title">Choose your system.</h2>
        </div>
        <p>
          Device detection highlights one likely match. You still choose the
          package and architecture.
        </p>
      </div>

      <ReleaseSafetyNotice />
      <DownloadGrid />
    </div>
  </section>

  <section class="verify-section section--deep" aria-labelledby="verify-title">
    <div class="shell verify-layout">
      <div>
        <p class="eyebrow">Integrity check</p>
        <h2 id="verify-title">Verify the file before opening it.</h2>
        <p>
          Compare the SHA-256 digest of your download with the value on its
          package card. Release details include the full evidence set.
        </p>
        <div class="button-row">
          <a class="button" href={sitePath(`/releases/${currentRelease.version}/`)}>
            Review release evidence
          </a>
          <a class="button button--secondary" href={sitePath("/releases/")}>
            Release history
          </a>
        </div>
      </div>

      <details class="checksum-help">
        <summary>Checksum commands</summary>
        <div>
          <span>Linux</span>
          <code>sha256sum &lt;package-file&gt;</code>
        </div>
        <div>
          <span>macOS</span>
          <code>shasum -a 256 &lt;package-file&gt;</code>
        </div>
        <div>
          <span>Windows PowerShell</span>
          <code>Get-FileHash &lt;package-file&gt; -Algorithm SHA256</code>
        </div>
      </details>
    </div>
  </section>
</BaseLayout>

<style>
  .download-hero {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--border-subtle);
  }

  .download-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.55fr);
    gap: clamp(2.5rem, 8vw, 7rem);
    align-items: end;
  }

  .download-hero h1 {
    margin-bottom: 1rem;
    font-size: clamp(3rem, 7vw, 5.6rem);
  }

  .current-release {
    display: grid;
    gap: 1.15rem;
    padding: 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .current-release > div {
    display: grid;
    gap: 0.1rem;
  }

  .current-release > div span,
  .current-release dt {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    text-transform: uppercase;
  }

  .current-release > div strong {
    color: var(--text-strong);
    font-size: 1.35rem;
    font-weight: 500;
  }

  .current-release dl {
    display: grid;
    gap: 0.65rem;
    margin: 0;
  }

  .current-release dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--border-subtle);
  }

  .current-release dd {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.76rem;
    text-align: right;
  }

  .current-release > a {
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 500;
    text-decoration: none;
  }

  .download-platforms {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .platforms-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  .platforms-heading h2 {
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 3.6rem);
  }

  .platforms-heading > p {
    max-width: 31rem;
    margin: 0;
  }

  :global(.release-safety) {
    margin-bottom: 1rem;
  }

  .verify-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .verify-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 0.75fr);
    gap: clamp(2.5rem, 8vw, 7rem);
    align-items: start;
  }

  .verify-layout h2 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
  }

  .checksum-help {
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .checksum-help summary {
    padding: 1rem 1.15rem;
    color: var(--text-strong);
    cursor: pointer;
    font-weight: 500;
  }

  .checksum-help > div {
    display: grid;
    min-width: 0;
    gap: 0.3rem;
    padding: 0.85rem 1.15rem;
    border-top: 1px solid var(--border-subtle);
  }

  .checksum-help span {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .checksum-help code {
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 800px) {
    .download-hero__layout,
    .platforms-heading,
    .verify-layout {
      grid-template-columns: 1fr;
    }

    .download-hero__layout {
      align-items: start;
    }
  }
</style>
