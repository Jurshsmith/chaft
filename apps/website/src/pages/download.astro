---
import DownloadGrid from "../components/DownloadGrid.astro";
import EarlyAccessCallout from "../components/EarlyAccessCallout.astro";
import PageHero from "../components/PageHero.astro";
import { currentRelease } from "../data/releases";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/site-path";

const description =
  "Chaft canary downloads for Windows, macOS, and Linux, with package availability, checksums, evidence, and signing status.";
const hasPublishedDownloads = currentRelease.assets.some((asset) => asset.available);
---

<BaseLayout title="Download" description={description}>
  <PageHero
    eyebrow={hasPublishedDownloads
      ? `Canary · v${currentRelease.version}`
      : "Canary · Packages pending"}
    title={hasPublishedDownloads
      ? "Choose an unsigned Chaft canary."
      : "Canary packages are being prepared."}
    lede={hasPublishedDownloads
      ? "Each native package passed its packaged-app smoke check and includes exact integrity evidence. These canaries are deliberately unsigned and are not production-ready."
      : "Windows, macOS, and Linux are supported targets. Build the current source today; verified public packages will appear here only after their release evidence is complete."}
  >
    <div class="button-row">
      <a
        class="button"
        href={hasPublishedDownloads
          ? "#platforms"
          : sitePath("/docs/getting-started/build-desktop/")}
      >
        {hasPublishedDownloads ? "Choose a platform" : "Build from source"}
      </a>
      <a class="button button--secondary" href={currentRelease.releaseUrl}>
        {hasPublishedDownloads ? "View GitHub release" : "Watch GitHub releases"}
      </a>
    </div>
  </PageHero>

  <section class="section" id="platforms">
    <div class="shell">
      <div class="release-strip">
        <span class="status">
          {currentRelease.status === "published" ? "Unsigned canary published" : "Canary packages pending"}
        </span>
        <div>
          <strong>{currentRelease.status === "published" ? "Current canary" : "Current canary candidate"}</strong>
          <span class="mono">v{currentRelease.version}</span>
        </div>
        <a href={sitePath(`/releases/${currentRelease.version}/`)}>View details →</a>
      </div>
      <DownloadGrid />
    </div>
  </section>

  <section class="section section--deep">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Release evidence</p>
          <h2>Know exactly what you are downloading.</h2>
        </div>
        <p>
          Every published package identifies its exact bytes, source revision, integrity
          evidence, and platform signing state.
        </p>
      </div>

      <div class="delivery-grid">
        <article>
          <span class="mono">01</span>
          <h3>Exact package</h3>
          <p>The version, architecture, filename, format, and byte size are shown before download.</p>
        </article>
        <article>
          <span class="mono">02</span>
          <h3>Integrity evidence</h3>
          <p>Checksums, an SBOM, source and build provenance, and native verification receipts accompany the package.</p>
        </article>
        <article>
          <span class="mono">03</span>
          <h3>Signing state</h3>
          <p>The page states whether each package is an unsigned canary, signed, or notarized. It never implies a stronger state.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell verification">
      <div>
        <p class="eyebrow">Verify before opening</p>
        <h2>Compare the package checksum.</h2>
      </div>
      <div class="prose">
        <p>
          Every published package includes a SHA-256 digest and a platform-qualified
          <strong>SHA256SUMS</strong> file, plus a CycloneDX SBOM, source and build
          provenance, and a native packaged-app smoke receipt. Calculate the digest
          locally, then compare it with the value shown on the download card and in
          the release evidence.
        </p>
        <div class="verification-commands">
          <div>
            <strong>Linux</strong>
            <pre><code>sha256sum &lt;package-file&gt;</code></pre>
          </div>
          <div>
            <strong>macOS</strong>
            <pre><code>shasum -a 256 &lt;package-file&gt;</code></pre>
          </div>
          <div>
            <strong>Windows PowerShell</strong>
            <pre><code>Get-FileHash &lt;package-file&gt; -Algorithm SHA256</code></pre>
          </div>
        </div>
        <p>
          The canary receipt explicitly records that signing and notarization were not
          performed; it is not signature evidence. Stable publication remains blocked
          until its platform-specific signing and notarization policy is satisfied.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--compact section--deep">
    <div class="shell">
      <EarlyAccessCallout />
    </div>
  </section>
</BaseLayout>

<style>
  .release-strip {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 1rem;
    padding: 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-deep);
  }

  .release-strip div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .release-strip a {
    color: var(--accent);
    font-size: 0.86rem;
    text-decoration: none;
  }

  .delivery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--border-subtle);
  }

  .delivery-grid article {
    min-height: 17rem;
    padding: 2rem;
    background: var(--surface-base);
  }

  .delivery-grid .mono {
    display: block;
    margin-bottom: 3.5rem;
    color: var(--accent);
  }

  .delivery-grid p {
    margin-bottom: 0;
  }

  .verification {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.75fr);
    gap: clamp(3rem, 8vw, 7rem);
  }

  pre {
    overflow-x: auto;
    max-width: 100%;
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface-deep);
    color: var(--secure);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .verification-commands {
    display: grid;
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .verification-commands > div {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .verification-commands strong {
    font-size: 0.84rem;
  }

  @media (max-width: 800px) {
    .release-strip {
      grid-template-columns: 1fr;
    }

    .delivery-grid,
    .verification {
      grid-template-columns: 1fr;
    }

    .delivery-grid article {
      min-height: auto;
    }

    .delivery-grid .mono {
      margin-bottom: 2rem;
    }
  }
</style>
