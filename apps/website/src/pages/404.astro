---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/site-path";
---

<BaseLayout
  title="Page not found"
  description="The requested Chaft page could not be found."
  noindex
>
  <section class="not-found">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1>We could not find that page.</h1>
      <p class="lede">The address may be outdated. Start again from the homepage or open the download page.</p>
      <div class="button-row">
        <a class="button" href={sitePath("/")}>Return home</a>
        <a class="button button--secondary" href={sitePath("/download/")}>Open downloads</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 67vh;
    align-items: center;
    padding-block: 5rem;
    background: var(--surface-deep);
  }

  .not-found h1 {
    max-width: 11ch;
  }

  .button-row {
    margin-top: 2rem;
  }
</style>
