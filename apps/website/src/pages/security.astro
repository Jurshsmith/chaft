---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/site-path";

const description =
  "Chaft's current security model, known canary-stage limits, and private vulnerability reporting process.";
---

<BaseLayout title="Security" description={description}>
  <PageHero
    eyebrow="Security status · Unaudited canary"
    title="What Chaft protects today."
    lede="Chaft encrypts message and attachment content, verifies signed history, and treats peers as untrusted. It has not completed an independent security audit and is not ready for sensitive production use."
  >
    <div class="button-row">
      <a class="button" href="https://github.com/Jurshsmith/chaft/security/advisories/new">Report privately</a>
      <a class="button button--secondary" href={sitePath("/docs/concepts/security-model/")}>Security model</a>
      <a class="button button--quiet" href="https://github.com/Jurshsmith/chaft/blob/main/SECURITY.md">Full policy</a>
    </div>
  </PageHero>

  <section class="security-summary" aria-label="Current security status">
    <dl class="shell security-summary__inner">
      <div><dt>Stage</dt><dd>Canary</dd></div>
      <div><dt>Independent audit</dt><dd>Not completed</dd></div>
      <div><dt>Sensitive use</dt><dd>Not recommended</dd></div>
      <div><dt>Reporting</dt><dd>Private advisories</dd></div>
    </dl>
  </section>

  <section class="section">
    <div class="shell security-grid">
      <div>
        <p class="eyebrow">Implemented today</p>
        <h2>Current security properties.</h2>
      </div>
      <ul class="invariant-list">
        <li><span>01</span><p>No central server is authoritative for workspace history.</p></li>
        <li><span>02</span><p>Local devices sign events with persistent device identities.</p></li>
        <li><span>03</span><p>Peers and optional replica nodes are treated as untrusted.</p></li>
        <li><span>04</span><p>Missing authorization context is rejected and reported as a history gap.</p></li>
        <li><span>05</span><p>Peer inputs, paths, frames, strings, and item counts remain bounded.</p></li>
      </ul>
    </div>
  </section>

  <section class="section section--deep">
    <div class="shell limits">
      <div>
        <span class="status">Not protected yet</span>
        <h2>Why the canary is not production-ready.</h2>
      </div>
      <div class="prose">
        <p>
          Chaft has not completed an independent security audit. OS-backed keychain or
          user-unlocked vault integration for local identity and secrets is also incomplete.
        </p>
        <p>
          Public relay and discovery remain default-deny. Production packaging, platform
          signing, notarization, and trusted update delivery remain release gates.
        </p>
        <p>
          Security fixes currently target the main branch until a supported public release
          channel exists.
        </p>
      </div>
    </div>
  </section>

  <section class="section report">
    <div class="shell report__inner">
      <div>
        <p class="eyebrow">Responsible disclosure</p>
        <h2>Share sensitive findings through a private channel.</h2>
      </div>
      <div>
        <p>
          Use GitHub Security Advisories for plaintext leakage, key exposure, signature or
          authorization bypasses, malformed peer acceptance, replica plaintext access, or
          denial-of-service through unbounded work.
        </p>
        <p>Do not open a public issue containing sensitive reproduction details.</p>
        <a class="button" href="https://github.com/Jurshsmith/chaft/security/advisories/new">Open a private advisory</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .security-summary {
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-raised);
  }

  .security-summary__inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block: 0;
  }

  .security-summary__inner div {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem clamp(0.8rem, 2vw, 1.5rem);
    border-inline-start: 1px solid var(--border-subtle);
  }

  .security-summary__inner div:last-child {
    border-inline-end: 1px solid var(--border-subtle);
  }

  .security-summary dt {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
  }

  .security-summary dd {
    margin: 0;
    color: var(--text-strong);
    font-size: 0.88rem;
  }

  .security-grid,
  .limits,
  .report__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(22rem, 1fr);
    gap: clamp(3rem, 9vw, 8rem);
  }

  .invariant-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle);
    list-style: none;
  }

  .invariant-list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .invariant-list span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .invariant-list p {
    margin: 0;
    color: var(--text-soft);
  }

  .limits h2 {
    margin-top: 1.4rem;
  }

  .report {
    border-top: 3px solid var(--warning);
  }

  .report p {
    max-width: 36rem;
  }

  .report .button {
    margin-top: 1rem;
  }

  @media (max-width: 800px) {
    .security-summary__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .security-summary__inner div:nth-child(n + 3) {
      border-top: 1px solid var(--border-subtle);
    }

    .security-grid,
    .limits,
    .report__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
