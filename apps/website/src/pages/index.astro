---
import DownloadGrid from "../components/DownloadGrid.astro";
import EarlyAccessCallout from "../components/EarlyAccessCallout.astro";
import LandingHero from "../components/LandingHero.astro";
import ProductRevealSection from "../components/landing/ProductRevealSection.astro";
import SecurityOverviewSection from "../components/landing/SecurityOverviewSection.astro";
import { currentRelease } from "../data/releases";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/site-path";

const description =
  "Open-source team chat for small teams. Chaft stores history on participating devices, encrypts content, and syncs directly between trusted peers.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Chaft",
  description,
  applicationCategory: "CommunicationApplication",
  operatingSystem: ["Windows", "macOS", "Linux"],
  softwareVersion: currentRelease.version,
  isAccessibleForFree: true,
  codeRepository: "https://github.com/Jurshsmith/chaft",
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
};

const hasPublishedDownloads = currentRelease.assets.some((asset) => asset.available);

const features = [
  {
    title: "On-device by default",
    copy: "Messages, search, and history remain useful on each participating device—even when no central service is available.",
  },
  {
    title: "Direct when reachable",
    copy: "Trusted devices exchange signed history directly. Optional encrypted replicas can improve availability without reading message content.",
  },
  {
    title: "Team-owned continuity",
    copy: "Device reachability, recovery, and durable backups stay with your team. Optional replicas can improve availability without guaranteeing it.",
  },
  {
    title: "Public boundaries",
    copy: "The AGPL source, product limits, and current security gaps are documented instead of hidden behind a service promise.",
  },
];

const steps = [
  { number: "01", title: "Create", copy: "Name a private workspace on your device." },
  { number: "02", title: "Invite", copy: "Share a one-use or bounded group invite with teammates." },
  { number: "03", title: "Sync", copy: "Keep Chaft open while trusted devices exchange new history." },
];
---

<BaseLayout title="Chaft" description={description} structuredData={structuredData}>
  <LandingHero {hasPublishedDownloads} />

  <div class="trust-rail">
    <dl class="shell trust-rail__inner" aria-label="Chaft attributes">
      <div>
        <dt>On-device history</dt>
        <dd>Useful without a central service</dd>
      </div>
      <div>
        <dt>Direct sync</dt>
        <dd>When teammates are reachable</dd>
      </div>
      <div>
        <dt>Encrypted content</dt>
        <dd>Metadata is not fully hidden</dd>
      </div>
      <div>
        <dt>Open source</dt>
        <dd>AGPL-3.0-or-later</dd>
      </div>
    </dl>
  </div>

  <ProductRevealSection />

  <SecurityOverviewSection />

  <section class="section" id="why-chaft">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Lower infrastructure, clear tradeoffs</p>
          <h2>Built without a permanent SaaS bill.</h2>
        </div>
        <p class="body-copy">
          Participating devices provide the storage, compute, and most synchronization.
          That lowers recurring infrastructure, but makes reachability and backups your
          team's responsibility.
        </p>
      </div>

      <div class="card-grid">
        {features.map((feature, index) => (
          <article class="feature-card">
            <span class="feature-card__index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{feature.title}</h3>
            <p class="body-copy">{feature.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--deep" id="how-it-works">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">How it works</p>
          <h2>Create a workspace. Invite your team. Sync directly.</h2>
        </div>
        <p class="body-copy">
          Each device keeps its own identity and verified history. Chaft exchanges
          updates when trusted peers are reachable.
        </p>
      </div>

      <ol class="steps">
        {steps.map((step) => (
          <li>
            <span>{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p class="body-copy">{step.copy}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--compact docs-entry">
    <div class="shell">
      <div class="docs-entry__inner">
        <div>
          <p class="eyebrow">Documentation</p>
          <h2>Start with what you need.</h2>
        </div>
        <div class="docs-entry__copy">
          <p class="body-copy">
            Try the current workflow, review the security boundaries, or understand
            the architecture. Contributor guides cover builds, tests, and releases.
          </p>
          <a class="button button--secondary" href={sitePath("/docs/")}>
            Browse all documentation <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <nav class="docs-entry__links" aria-label="Documentation highlights">
        <a href={sitePath("/docs/getting-started/workspace-lifecycle/")}>
          <span>Getting started</span>
          <strong>Create and join a workspace</strong>
        </a>
        <a href={sitePath("/docs/concepts/architecture/")}>
          <span>Architecture</span>
          <strong>See how the pieces fit</strong>
        </a>
        <a href={sitePath("/docs/concepts/security-model/")}>
          <span>Security model</span>
          <strong>Know the canary boundaries</strong>
        </a>
        <a href={sitePath("/docs/development/testing/")}>
          <span>Build and contribute</span>
          <strong>Run the right project checks</strong>
        </a>
      </nav>
    </div>
  </section>

  <section class="section" id="downloads">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Canary downloads</p>
          <h2>
            {hasPublishedDownloads
              ? "Download Chaft for Windows, macOS, or Linux."
              : "Packages are being validated for Windows, macOS, and Linux."}
          </h2>
        </div>
        <p class="body-copy">
          {hasPublishedDownloads
            ? "Choose a platform to see the exact package, size, checksum, and signing state."
            : "No public package is available yet. Build from source or watch the release status while native packages complete verification."}
        </p>
      </div>
      <DownloadGrid compact />
      <div class="download-footer">
        <p class="body-copy">
          {hasPublishedDownloads
            ? `Chaft ${currentRelease.version} artifacts and verification details are ready.`
            : "Canary packages are pending. CI artifacts are not public downloads."}
        </p>
        <a
          class="button button--secondary"
          href={sitePath("/download/")}
        >
          {hasPublishedDownloads ? "All download details" : "View download status"}
        </a>
      </div>
    </div>
  </section>

  <section class="section section--compact section--deep">
    <div class="shell">
      <EarlyAccessCallout />
    </div>
  </section>

</BaseLayout>

<style>
  .trust-rail {
    background: var(--surface-raised);
  }

  .trust-rail__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-block: 0;
    padding-block: 0;
  }

  .trust-rail__inner > div {
    display: grid;
    gap: 0.28rem;
    padding: 1.25rem clamp(0.8rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--border-subtle);
  }

  .trust-rail__inner > div:first-child {
    border-left: 1px solid var(--border-subtle);
  }

  .trust-rail__inner > div {
    border-right: 1px solid var(--border-subtle);
  }

  .trust-rail dt {
    color: var(--text-strong);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .trust-rail dd {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.63rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--border-subtle);
    list-style: none;
  }

  .steps li {
    min-height: 18rem;
    padding: 1.6rem;
  }

  .steps li + li {
    border-left: 1px solid var(--border-subtle);
  }

  .steps li > span {
    display: block;
    margin-bottom: 6rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .steps p {
    max-width: 17rem;
    margin-bottom: 0;
  }

  .download-footer {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .download-footer p {
    max-width: 38rem;
    margin: 0;
    font-size: 0.88rem;
  }

  .docs-entry {
    border-block: 1px solid var(--border-subtle);
    background: var(--surface-raised);
  }

  .docs-entry__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.75fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
  }

  .docs-entry h2 {
    max-width: 17ch;
    margin-bottom: 0;
    font-size: clamp(2rem, 4.4vw, 3.5rem);
  }

  .docs-entry__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .docs-entry__copy p {
    max-width: 36rem;
    margin: 0;
  }

  .docs-entry__links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(2rem, 5vw, 3.25rem);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--border-subtle);
  }

  .docs-entry__links a {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
    min-height: 7rem;
    align-content: center;
    padding: 1rem;
    background: var(--surface-deep);
    text-decoration: none;
    transition: background-color var(--motion-quick);
  }

  .docs-entry__links a:hover {
    background: var(--surface-active);
  }

  .docs-entry__links span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .docs-entry__links strong {
    color: var(--text-soft);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.35;
  }

  @media (max-width: 940px) {
    .docs-entry__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .docs-entry__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .trust-rail__inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .docs-entry__links {
      grid-template-columns: 1fr;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .steps li {
      min-height: auto;
    }

    .steps li + li {
      border-top: 1px solid var(--border-subtle);
      border-left: 0;
    }

    .steps li > span {
      margin-bottom: 2rem;
    }

    :global(.feature-card) {
      min-height: auto;
    }

    :global(.feature-card__index) {
      margin-block-end: 2rem;
    }

    .download-footer {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
