---
import CanaryNotice from "../components/CanaryNotice.astro";
import LandingHero from "../components/LandingHero.astro";
import CommunitySection from "../components/landing/CommunitySection.astro";
import ProductMoments from "../components/landing/ProductMoments.astro";
import { currentRelease } from "../data/releases";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/site-path";

const description =
  "Open-source desktop chat for small teams. Chaft keeps message history on each teammate's device and syncs new activity between authorized devices when they connect.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Chaft",
  description,
  applicationCategory: "CommunicationApplication",
  operatingSystem: ["Windows", "macOS", "Linux"],
  softwareVersion: currentRelease.version,
  isAccessibleForFree: true,
  codeRepository: "https://github.com/Jurshsmith/chaft",
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
};

const hasPublishedDownloads = currentRelease.assets.some((asset) => asset.available);

const differences = [
  {
    title: "History lives on your devices",
    copy: "Authorized devices keep a useful local copy of workspace history.",
  },
  {
    title: "New activity syncs when devices connect",
    copy: "Authorized devices exchange signed updates directly when they connect.",
  },
  {
    title: "Content is encrypted before sync",
    copy: "Messages and attachments are encrypted before sync; some metadata remains visible.",
  },
];

const steps = [
  { title: "Create", copy: "Start a workspace and add the rooms your team needs." },
  { title: "Invite", copy: "Share an invitation and review who can enter." },
  { title: "Sync", copy: "Connected devices exchange and verify new activity." },
];
---

<BaseLayout title="Chaft" description={description} structuredData={structuredData}>
  <LandingHero {hasPublishedDownloads} />

  <ProductMoments />

  <section class="section difference" aria-labelledby="difference-title">
    <div class="shell difference__grid">
      <div class="difference__intro">
        <p class="section-kicker">Why Chaft is different</p>
        <h2 id="difference-title">Your workspace stays with your team.</h2>
        <p class="body-copy">
          Each device keeps workspace history. That removes the required hosted
          workspace—and makes the tradeoffs yours to manage.
        </p>
        <a href={sitePath("/docs/concepts/architecture/")}>Read the architecture overview <span aria-hidden="true">→</span></a>
      </div>

      <dl class="difference-list">
        {differences.map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd>{item.copy}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section sync-story" id="how-it-works" aria-labelledby="sync-title">
    <div class="shell">
      <div class="sync-story__heading">
        <p class="section-kicker">How it works</p>
        <h2 id="sync-title">Create, invite, then sync.</h2>
        <p class="body-copy">
          Each device has its own identity and verified history. New activity moves
          when teammates connect.
        </p>
      </div>

      <ol class="sync-steps">
        {steps.map((step, index) => (
          <li>
            <span class="sync-steps__number">{index + 1}</span>
            <div class="sync-steps__icon" aria-hidden="true">
              {index === 0 && <><i></i><b>#</b></>}
              {index === 1 && <><i></i><i></i><b>＋</b></>}
              {index === 2 && <><i></i><i></i><b>↔</b></>}
            </div>
            <h3>{step.title}</h3>
            <p class="body-copy">{step.copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section responsibilities" aria-labelledby="responsibilities-title">
    <div class="shell">
      <div class="responsibilities__heading">
        <p class="section-kicker">A clearer exchange</p>
        <h2 id="responsibilities-title">What Chaft provides—and what your team manages.</h2>
      </div>

      <div class="responsibility-grid">
        <section aria-labelledby="provided-title">
          <p class="responsibility-grid__label">Chaft provides</p>
          <h3 id="provided-title">A useful local workspace</h3>
          <ul>
            <li>Local message history and search</li>
            <li>Signed updates between authorized devices</li>
            <li>Encrypted message and attachment content</li>
          </ul>
        </section>
        <section aria-labelledby="managed-title">
          <p class="responsibility-grid__label">Your team manages</p>
          <h3 id="managed-title">The operational tradeoffs</h3>
          <ul>
            <li>Device security and credential care</li>
            <li>Backups and workspace recovery</li>
            <li>Device reachability and metadata limits</li>
          </ul>
        </section>
      </div>
    </div>
  </section>

  <CommunitySection />

  <section class="section section--compact evaluation">
    <div class="shell"><CanaryNotice /></div>
  </section>

  <nav class="resource-strip" aria-label="Learn more about Chaft">
    <div class="shell resource-strip__inner">
      <a href={sitePath("/docs/concepts/architecture/")}><span>Architecture</span><b>How devices and history fit together</b></a>
      <a href={sitePath("/security/")}><span>Security</span><b>Properties, limits, and reporting</b></a>
      <a href={sitePath("/docs/")}><span>Documentation</span><b>Install, evaluate, and contribute</b></a>
      <a href="https://github.com/Jurshsmith/chaft"><span>Source</span><b>Read and contribute under AGPL</b></a>
    </div>
  </nav>
</BaseLayout>

<style>
  .section-kicker {
    margin-bottom: 1rem;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .difference {
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-base);
  }

  .difference__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(24rem, 1.18fr);
    gap: clamp(3rem, 9vw, 9rem);
  }

  .difference__intro {
    align-self: start;
    position: sticky;
    top: 7rem;
  }

  .difference__intro h2 {
    max-width: 12ch;
  }

  .difference__intro > .body-copy {
    max-width: 31rem;
  }

  .difference__intro > a {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    margin-top: 1rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }

  .difference-list {
    margin: 0;
    border-top: 1px solid var(--border-subtle);
  }

  .difference-list > div {
    padding-block: clamp(1.8rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--border-subtle);
  }

  .difference-list dt {
    color: var(--text-strong);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .difference-list dd {
    max-width: 38rem;
    margin: 0.7rem 0 0;
    color: var(--text-muted);
    font-family: var(--font-body);
  }

  .sync-story {
    --accent: #72dbba;
    --border-subtle: #34423e;
    --text-muted: #b5c0bc;
    --text-strong: #fffdf7;
    background: #17211f;
    color: var(--text-strong);
  }

  .sync-story__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.62fr);
    gap: 0 clamp(3rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .sync-story__heading .section-kicker {
    grid-column: 1 / -1;
  }

  .sync-story__heading h2,
  .sync-story__heading p {
    color: var(--text-strong);
  }

  .sync-story__heading h2 { margin: 0; }

  .sync-story__heading .body-copy {
    margin: 0;
    color: var(--text-muted);
  }

  .sync-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--border-subtle);
    list-style: none;
  }

  .sync-steps li {
    position: relative;
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .sync-steps li + li { border-left: 1px solid var(--border-subtle); }

  .sync-steps__number {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid #5b6b65;
    border-radius: 50%;
    color: #72dbba;
    font-size: 0.78rem;
  }

  .sync-steps__icon {
    position: relative;
    display: grid;
    width: 100%;
    height: 8rem;
    place-items: center;
    margin-block: 1.5rem;
    border-radius: var(--radius-sm);
    background: #111a17;
  }

  .sync-steps__icon i {
    position: absolute;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid #557169;
    border-radius: 0.55rem;
    background: #22312c;
  }

  .sync-steps__icon i:first-child { transform: translateX(-1.25rem); }
  .sync-steps__icon i:nth-child(2) { transform: translateX(1.25rem); }

  .sync-steps__icon b {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: #087054;
    color: #fff;
    font-weight: 500;
  }

  .sync-steps h3 { color: var(--text-strong); }

  .sync-steps p {
    max-width: 21rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.94rem;
  }

  .responsibilities {
    background: var(--surface-raised);
  }

  .responsibilities__heading {
    max-width: 48rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .responsibility-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .responsibility-grid > section {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .responsibility-grid > section + section {
    border-left: 1px solid var(--border-subtle);
    background: var(--surface-base);
  }

  .responsibility-grid__label {
    margin-bottom: 0.7rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .responsibility-grid h3 {
    font-size: clamp(1.45rem, 2.5vw, 2rem);
  }

  .responsibility-grid ul {
    display: grid;
    gap: 0.75rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .responsibility-grid li {
    display: flex;
    gap: 0.65rem;
    color: var(--text-muted);
  }

  .responsibility-grid li::before {
    color: var(--accent);
    content: "—";
  }

  .evaluation {
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-base);
  }

  .resource-strip {
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-raised);
  }

  .resource-strip__inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .resource-strip a {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    min-height: 7rem;
    align-content: center;
    padding: 1rem;
    text-decoration: none;
  }

  .resource-strip a + a { border-left: 1px solid var(--border-subtle); }

  .resource-strip span {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .resource-strip b {
    color: var(--text-soft);
    font-size: 0.86rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .resource-strip a:hover { background: var(--surface-active); }

  @media (max-width: 820px) {
    .difference__grid,
    .sync-story__heading {
      grid-template-columns: 1fr;
    }

    .difference__intro { position: static; }
    .difference-list { margin-top: 1rem; }
    .sync-story__heading .body-copy { margin-top: 1rem; }

    .sync-steps { grid-template-columns: 1fr; }

    .sync-steps li {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.3rem 1rem;
      min-height: 0;
      padding-block: 1.4rem;
    }

    .sync-steps li + li { border-top: 1px solid var(--border-subtle); border-left: 0; }

    .sync-steps__number {
      grid-row: 1 / span 2;
    }

    .sync-steps__icon { display: none; }
    .sync-steps h3 { margin: 0; }
    .sync-steps p { grid-column: 2; }

    .responsibility-grid { grid-template-columns: 1fr; }
    .responsibility-grid > section + section { border-top: 1px solid var(--border-subtle); border-left: 0; }

    .resource-strip__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .resource-strip a:nth-child(3) { border-left: 0; }
    .resource-strip a:nth-child(n + 3) { border-top: 1px solid var(--border-subtle); }
  }

  @media (max-width: 480px) {
    .difference,
    .responsibilities,
    .sync-story {
      padding-block: 3rem;
    }

    .difference-list > div {
      padding-block: 1.1rem;
    }

    .responsibility-grid > section {
      padding: 1.35rem;
    }

    .responsibility-grid ul {
      gap: 0.55rem;
      margin-top: 1rem;
    }

    .resource-strip a {
      padding-inline: 0.8rem;
    }
  }
</style>
