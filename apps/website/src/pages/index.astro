---
import DownloadGrid from "../components/DownloadGrid.astro";
import EarlyAccessCallout from "../components/EarlyAccessCallout.astro";
import PeerMeshVisual from "../components/PeerMeshVisual.astro";
import { currentRelease } from "../data/releases";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/site-path";

const description =
  "Chaft is an experimental P2P-first Slack alternative for small teams, designed to keep essential collaboration free within deliberate limits.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Chaft",
  description,
  applicationCategory: "CommunicationApplication",
  operatingSystem: ["Windows", "macOS", "Linux"],
  softwareVersion: currentRelease.version,
  isAccessibleForFree: true,
  codeRepository: "https://github.com/Jurshsmith/chaft",
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
};

const hasPublishedDownloads = currentRelease.assets.some((asset) => asset.available);
const primaryHref = hasPublishedDownloads
  ? sitePath("/download/")
  : sitePath("/docs/getting-started/build-desktop/");
const primaryLabel = hasPublishedDownloads ? "Download Chaft" : "Build the canary";

const features = [
  {
    title: "Local-first storage",
    copy: "Messages, search, and history stay useful on your device instead of depending on a central service to render the workspace.",
  },
  {
    title: "Direct peer sync",
    copy: "Teammates reconcile directly when reachable, with optional encrypted replicas supporting recovery without becoming the authority.",
  },
  {
    title: "Encrypted content",
    copy: "End-to-end encrypted content and signed events let each device verify what it receives before materializing history.",
  },
  {
    title: "Bounded by design",
    copy: "Chaft targets the essentials small teams need, keeping the free-software promise tied to explicit product and infrastructure limits.",
  },
];

const steps = [
  { number: "01", title: "Create", copy: "Name a private workspace on your device." },
  { number: "02", title: "Invite", copy: "Share a one-use or bounded group invite with teammates." },
  { number: "03", title: "Stay reachable", copy: "Keep Chaft open while trusted devices reconcile directly." },
];
---

<BaseLayout title="Chaft" description={description} structuredData={structuredData}>
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Experimental · P2P-first · Canary</p>
        <h1>Team chat designed to stay free.</h1>
        <p class="lede">
          Chaft is an experimental Slack alternative for small teams. Local-first
          storage, end-to-end encrypted content, and direct peer replication reduce
          dependence on costly central infrastructure.
        </p>
        <div class="button-row hero__actions">
          <a class="button" href={primaryHref}>
            {primaryLabel}
            <span aria-hidden="true">→</span>
          </a>
          <a class="button button--secondary" href={sitePath("/docs/")}>Read the docs</a>
          <a class="button button--quiet" href="https://github.com/Jurshsmith/chaft">Explore the source</a>
        </div>
        <p class="hero__note">
          <span class="status">Canary</span>
          Not yet recommended for sensitive production communication.
        </p>
      </div>

      <div class="hero__visual">
        <PeerMeshVisual />
      </div>
    </div>
  </section>

  <div class="trust-rail" aria-label="Chaft attributes">
    <div class="shell trust-rail__inner">
      <span>Local-first</span>
      <span>Direct peer sync</span>
      <span>Encrypted content</span>
      <span>Free software</span>
    </div>
  </div>

  <section class="section" id="why-chaft">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Lower infrastructure by design</p>
          <h2>Software should be cheap to sustain, too.</h2>
        </div>
        <p>
          AI is making software cheaper to create. Chaft explores whether peer-to-peer
          architecture can also make collaboration software cheaper to sustain—without
          pretending the tradeoffs disappear.
        </p>
      </div>

      <div class="card-grid">
        {features.map((feature, index) => (
          <article class="feature-card">
            <span class="feature-card__index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{feature.title}</h3>
            <p>{feature.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--deep" id="how-it-works">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">How it works</p>
          <h2>Create a workspace. Invite your people. Keep talking.</h2>
        </div>
        <p>
          A local device becomes a participant—not a thin window into a central
          authority. Each teammate keeps their own identity and verified history.
        </p>
      </div>

      <ol class="steps">
        {steps.map((step) => (
          <li>
            <span>{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--compact docs-entry">
    <div class="shell">
      <div class="docs-entry__inner">
        <div>
          <p class="eyebrow">Documentation</p>
          <h2>Understand the model, then make it yours.</h2>
        </div>
        <div class="docs-entry__copy">
          <p>
            Start with the desktop build, learn how local-first replication works,
            or use the contributor reference. Every guide reflects the current
            canary implementation.
          </p>
          <a class="button button--secondary" href={sitePath("/docs/")}>
            Browse all documentation <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <nav class="docs-entry__links" aria-label="Documentation highlights">
        <a href={sitePath("/docs/getting-started/workspace-lifecycle/")}>
          <span>Getting started</span>
          <strong>Create and join a workspace</strong>
        </a>
        <a href={sitePath("/docs/concepts/architecture/")}>
          <span>Architecture</span>
          <strong>See how the pieces fit</strong>
        </a>
        <a href={sitePath("/docs/concepts/security-model/")}>
          <span>Security model</span>
          <strong>Know the canary boundaries</strong>
        </a>
        <a href={sitePath("/docs/development/testing/")}>
          <span>Build and contribute</span>
          <strong>Run the right project checks</strong>
        </a>
      </nav>
    </div>
  </section>

  <section class="section" id="downloads">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Canary builds</p>
          <h2>Windows, macOS, and Linux stay first-class.</h2>
        </div>
        <p>
          Public packages are being prepared. Build from source today; every supported
          platform remains visible and no download starts automatically.
        </p>
      </div>
      <DownloadGrid compact />
      <div class="download-footer">
        <p>
          {hasPublishedDownloads
            ? `Chaft ${currentRelease.version} artifacts and verification details are ready.`
            : "Public canary packages are not published yet. The current source remains available to build and test."}
        </p>
        <a
          class="button button--secondary"
          href={hasPublishedDownloads
            ? sitePath("/download/")
            : sitePath("/docs/getting-started/build-desktop/")}
        >
          {hasPublishedDownloads ? "All download details" : "Build the canary"}
        </a>
      </div>
    </div>
  </section>

  <section class="section section--compact section--deep">
    <div class="shell">
      <EarlyAccessCallout />
    </div>
  </section>

  <section class="section open-source">
    <div class="shell open-source__inner">
      <p class="eyebrow">Free within limits</p>
      <h2>Small-team collaboration without a permanent SaaS bill.</h2>
      <p class="lede">
        Chaft aims to keep the core experience free by shifting storage and replication
        to participating devices. That promise is bounded by deliberate product limits,
        not unlimited hosted infrastructure. The AGPL source and every current boundary
        are public.
      </p>
      <div class="button-row">
        <a class="button" href="https://github.com/Jurshsmith/chaft">Explore the source</a>
        <a class="button button--secondary" href="https://github.com/Jurshsmith/chaft/blob/main/CONTRIBUTING.md">
          Contribute
        </a>
        <a class="button button--quiet" href={sitePath("/releases/")}>Release status</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .hero::after {
    position: absolute;
    top: 8%;
    right: -8rem;
    z-index: -1;
    width: 22rem;
    height: 22rem;
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    background: var(--surface-raised);
    opacity: 0.32;
    content: "";
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(23rem, 0.85fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
  }

  .hero__copy {
    position: relative;
    z-index: 2;
  }

  .hero__actions {
    margin-top: 2.25rem;
  }

  .hero__note {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
    margin-top: 2rem;
    margin-bottom: 0;
    color: var(--text-faint);
    font-size: 0.8rem;
  }

  .hero__visual {
    position: relative;
  }

  .hero__visual::before {
    position: absolute;
    inset: -1rem 1rem 1rem -1rem;
    z-index: -1;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    content: "";
  }

  .trust-rail {
    border-block: 1px solid var(--border-subtle);
    background: var(--surface-deep);
  }

  .trust-rail__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .trust-rail span {
    padding-block: 1.15rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-align: center;
    text-transform: uppercase;
  }

  .trust-rail span + span {
    border-left: 1px solid var(--border-subtle);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--border-subtle);
    list-style: none;
  }

  .steps li {
    min-height: 18rem;
    padding: 1.6rem;
  }

  .steps li + li {
    border-left: 1px solid var(--border-subtle);
  }

  .steps li > span {
    display: block;
    margin-bottom: 6rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .steps p {
    max-width: 17rem;
    margin-bottom: 0;
  }

  .download-footer {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .download-footer p {
    max-width: 38rem;
    margin: 0;
    font-size: 0.88rem;
  }

  .docs-entry {
    border-block: 1px solid var(--border-subtle);
    background: var(--surface-raised);
  }

  .docs-entry__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.75fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
  }

  .docs-entry h2 {
    max-width: 17ch;
    margin-bottom: 0;
    font-size: clamp(2rem, 4.4vw, 3.5rem);
  }

  .docs-entry__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .docs-entry__copy p {
    max-width: 36rem;
    margin: 0;
  }

  .docs-entry__links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(2rem, 5vw, 3.25rem);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--border-subtle);
  }

  .docs-entry__links a {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
    min-height: 7rem;
    align-content: center;
    padding: 1rem;
    background: var(--surface-deep);
    text-decoration: none;
    transition: background-color var(--motion-quick);
  }

  .docs-entry__links a:hover {
    background: var(--surface-active);
  }

  .docs-entry__links span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .docs-entry__links strong {
    color: var(--text-soft);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .open-source__inner {
    display: grid;
    justify-items: start;
  }

  .open-source h2 {
    max-width: 20ch;
  }

  .open-source .button-row {
    margin-top: 1rem;
  }

  @media (max-width: 940px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .docs-entry__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero__visual {
      width: min(100%, 42rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 680px) {
    .docs-entry__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .trust-rail__inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .docs-entry__links {
      grid-template-columns: 1fr;
    }

    .trust-rail span:nth-child(3) {
      border-left: 0;
      border-top: 1px solid var(--border-subtle);
    }

    .trust-rail span:nth-child(4) {
      border-top: 1px solid var(--border-subtle);
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .steps li {
      min-height: auto;
    }

    .steps li + li {
      border-top: 1px solid var(--border-subtle);
      border-left: 0;
    }

    .steps li > span {
      margin-bottom: 2rem;
    }

    .download-footer {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
