---
import PageHero from "../../components/PageHero.astro";
import {
  allReleases,
  currentRelease,
  unsignedCanaryWarning,
} from "../../data/releases";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../lib/site-path";

const description = "Chaft canary and desktop release status, artifacts, and integrity metadata.";
const isUnsignedCanary =
  currentRelease.channel === "canary" &&
  currentRelease.status === "published";

function channelLabel(channel: string): string {
  return channel === "canary" ? "Canary" : "Stable";
}
---

<BaseLayout title="Releases" description={description}>
  <PageHero
    eyebrow="Release history"
    title="Know exactly what you are downloading."
    lede="Every public Chaft package is tied to an immutable GitHub Release and shows its checksum, source revision, build evidence, and signing state."
  />

  {isUnsignedCanary && (
    <section class="section section--compact">
      <div class="shell">
        <aside class="canary-warning" role="note">
          <strong>Unsigned canary</strong>
          <p>{unsignedCanaryWarning}</p>
          <span class="mono">{currentRelease.tag}</span>
        </aside>
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell">
      <div class="release-list">
        {allReleases.map((release) => {
          const isCurrent = release.version === currentRelease.version;
          return (
            <article class="release-card">
              <div class="release-card__heading">
                <span class="status">
                  {isCurrent
                    ? release.status === "published" ? "Current release" : "Packages pending"
                    : "Archived release"}
                </span>
                <span class="mono">{channelLabel(release.channel)}</span>
              </div>
              <div>
                <p class="release-card__version">
                  {release.status === "published" ? "Version" : "Source version"} · v{release.version}
                </p>
                <h2>
                  {isCurrent && release.status !== "published"
                    ? "No public canary yet"
                    : `Chaft ${release.version}`}
                </h2>
                <p>
                  Windows, macOS, and Linux packages
                  {release.status === "published" ? " are available." : " are still being validated."}
                </p>
              </div>
              <div class="release-card__links">
                <a class="button" href={sitePath(`/releases/${release.version}/`)}>View release details</a>
                <a class="button button--secondary" href={sitePath(`/releases/${release.version}.json`)}>
                  Version JSON
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--deep">
    <div class="shell pipeline">
      <div>
        <p class="eyebrow">Publication standard</p>
        <h2>What accompanies a public release.</h2>
      </div>
      <ol>
        <li><span>01</span>Native builds and packaged-app smoke tests for every platform.</li>
        <li><span>02</span>Final filenames, byte sizes, and SHA-256 digests.</li>
        <li><span>03</span>SBOMs, provenance, smoke receipts, inventory, and corresponding-source evidence.</li>
        <li><span>04</span>An explicit unsigned-canary state, or enforced signing and notarization for stable releases.</li>
        <li><span>05</span>Immutable GitHub Release assets reflected by the website manifest.</li>
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .canary-warning {
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--secure-surface);
  }

  .canary-warning strong {
    color: var(--accent);
  }

  .canary-warning p {
    margin: 0;
  }

  .canary-warning .mono {
    color: var(--text-faint);
    font-size: 0.72rem;
  }

  .release-card {
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .release-list {
    display: grid;
    gap: 1rem;
  }

  .release-card__heading,
  .release-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .release-card__version {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .release-card h2 {
    margin-bottom: 0.8rem;
  }

  .pipeline {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1fr);
    gap: clamp(3rem, 9vw, 8rem);
  }

  .pipeline ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle);
    list-style: none;
  }

  .pipeline li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-soft);
  }

  .pipeline li span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (max-width: 760px) {
    .pipeline {
      grid-template-columns: 1fr;
    }

    .release-card__links {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
