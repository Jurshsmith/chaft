---
import { Image } from "astro:assets";

import mark from "../../../desktop-qt/resources/branding/chaft-mark.png";
import { currentRelease } from "../data/releases";
import { sitePath } from "../lib/site-path";

interface HeaderLink {
  href: string;
  label: string;
  external?: boolean;
  matchPrefix?: boolean;
}

const currentPath = Astro.url.pathname;
const isDocs = currentPath.startsWith(sitePath("/docs/"));
const links: HeaderLink[] = [
  { href: sitePath("/#why-chaft"), label: "Why Chaft" },
  { href: sitePath("/docs/"), label: "Docs", matchPrefix: true },
  { href: sitePath("/security/"), label: "Security" },
  { href: "https://github.com/Jurshsmith/chaft", label: "Source", external: true },
];

const downloadHref = sitePath("/download/");
const downloadLabel = currentRelease.assets.some((asset) => asset.available)
  ? "Download"
  : "Canary";

function isCurrentLink(link: HeaderLink): boolean {
  if (link.external) return false;
  if (link.matchPrefix) return currentPath.startsWith(link.href);
  return currentPath === link.href;
}
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={sitePath("/")} aria-label="Chaft home">
      <span class="brand-mark" aria-hidden="true">
        <Image
          src={mark}
          alt=""
          width={40}
          height={40}
          format="webp"
          quality={90}
          loading="eager"
        />
      </span>
      <span class="brand-name">chaft</span>
      {isDocs && <span class="brand-context">/ docs</span>}
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrentLink(link) ? "page" : undefined}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
            >
              {link.label}
              {link.external && <span class="sr-only"> (opens in a new tab)</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-download" href={downloadHref} aria-current={currentPath === downloadHref ? "page" : undefined}>
      {downloadLabel}
    </a>

    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrentLink(link) ? "page" : undefined}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
          >
            {link.label}
            {link.external && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        ))}
        <a href={downloadHref} aria-current={currentPath === downloadHref ? "page" : undefined}>
          {downloadLabel}
        </a>
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  document.querySelectorAll(".mobile-nav").forEach((menu) => {
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        menu.removeAttribute("open");
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    padding-block: 0.7rem;
    background: color-mix(in srgb, var(--surface-base) 96%, transparent);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    min-height: 3.8rem;
    align-items: center;
    gap: 2rem;
    padding: 0.38rem 0.45rem 0.38rem 0.7rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-strong);
    font-size: 1.28rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
  }

  .brand-mark img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .brand-context {
    padding-left: 0.55rem;
    border-left: 1px solid var(--border-subtle);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .desktop-nav {
    justify-self: center;
  }

  ul {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav a {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color var(--motion-quick);
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--text-strong);
  }

  .desktop-nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: 0.2rem;
    left: 0;
    height: 2px;
    background: var(--brand-coral);
    content: "";
  }

  .header-download {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.56rem 0.75rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition:
      border-color var(--motion-quick),
      background-color var(--motion-quick);
  }

  .header-download:hover {
    border-color: var(--text-strong);
    background: var(--text-strong);
  }

  .mobile-nav {
    position: relative;
    display: none;
  }

  .mobile-nav summary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 500;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav[open] summary {
    border-color: var(--accent);
    color: var(--text-strong);
  }

  .mobile-nav nav {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    display: grid;
    min-width: 12rem;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    box-shadow: var(--shadow-lift);
  }

  .mobile-nav nav a {
    min-height: 2.9rem;
    padding: 0.75rem 0.9rem;
    color: var(--text-soft);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .mobile-nav nav a + a {
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-nav nav a:hover,
  .mobile-nav nav a[aria-current="page"] {
    background: var(--secure-surface);
    color: var(--text-strong);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      gap: 0.5rem;
    }

    .desktop-nav {
      display: none;
    }

    .header-download {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 360px) {
    .brand-name {
      display: none;
    }

    .brand-context {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
