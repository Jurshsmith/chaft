---
import {
  currentRelease,
  formatBytes,
  formatSigningStatus,
  unsignedCanaryWarning,
} from "../data/releases";
import { buildDownloadPlatforms } from "../lib/download-options";
import { sitePath } from "../lib/site-path";

const platforms = buildDownloadPlatforms(currentRelease);
const defaultPlatform = platforms[0]?.id ?? "windows";
const hasPublishedDownloads = currentRelease.assets.some(
  (asset) => asset.available,
);
const publishedDate = currentRelease.publishedAt
  ? new Intl.DateTimeFormat("en", {
      day: "numeric",
      month: "long",
      timeZone: "UTC",
      year: "numeric",
    }).format(new Date(currentRelease.publishedAt))
  : "Publication pending";
const platformDescriptions = {
  windows: "A portable package for 64-bit Windows systems.",
  macos: "Choose the build that matches your Mac processor.",
  linux: "A portable AppImage for 64-bit Linux systems.",
} as const;
---

<section
  class="download-experience"
  id="platforms"
  data-download-experience
  data-download-platform={defaultPlatform}
  data-default-platform={defaultPlatform}
>
  <div class="shell download-experience__grid">
    <div class="download-experience__copy" data-download-copy>
      <p class="eyebrow">
        {hasPublishedDownloads
          ? `Canary · v${currentRelease.version}`
          : "Desktop canary · Packages pending"}
      </p>
      <h1>
        {hasPublishedDownloads
          ? "Download Chaft for desktop."
          : "Desktop packages are being prepared."}
      </h1>
      <p class="lede">
        {hasPublishedDownloads
          ? "Choose your platform. Current canary builds are unsigned and not for sensitive or production communication."
          : "Windows, macOS, and Linux are supported targets. Verified packages will appear after their release evidence is complete."}
      </p>

      <dl class="release-summary" aria-label="Current release summary">
        <div>
          <dt>Release</dt>
          <dd>v{currentRelease.version}</dd>
        </div>
        <div>
          <dt>Published</dt>
          <dd>{publishedDate}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{hasPublishedDownloads ? "Unsigned canary" : "Packages pending"}</dd>
        </div>
      </dl>

      <a
        class="release-link"
        href={sitePath(`/releases/${currentRelease.version}/`)}
      >
        View complete release evidence <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="download-experience__selector-wrap" data-download-selector>
      <div class="download-experience__glow" aria-hidden="true"></div>
      <div class="download-selector">
        <div class="download-selector__header">
          <div>
            <p class="download-selector__kicker">Desktop packages</p>
            <p class="download-selector__title">Choose your platform</p>
          </div>
          <span class="detected-platform" data-detected-platform hidden>
            Detected platform
          </span>
        </div>

        <nav
          class="platform-tabs"
          aria-label="Desktop operating systems"
          data-platform-tabs
        >
          {platforms.map((platform) => (
            <a
              class="platform-tab"
              id={`download-tab-${platform.id}`}
              href={`#download-panel-${platform.id}`}
              data-platform-tab={platform.id}
            >
              <span class="platform-tab__mark" aria-hidden="true">{platform.code}</span>
              <span>{platform.label}</span>
            </a>
          ))}
        </nav>

        <div class="download-panels">
          {platforms.map((platform) => (
            <section
              class="download-panel"
              id={`download-panel-${platform.id}`}
              data-platform-panel={platform.id}
              data-initial-visible={platform.id === defaultPlatform ? "" : undefined}
            >
              <div class="download-panel__heading">
                <div>
                  <p class="download-panel__platform">{platform.label}</p>
                  <p>{platformDescriptions[platform.id]}</p>
                </div>
              </div>

              {platform.options.length > 1 && (
                <div
                  class="variant-selector"
                  role="group"
                  aria-label={`${platform.label} processor`}
                  data-variant-selector
                >
                  {platform.options.map((option, index) => (
                    <button
                      type="button"
                      aria-controls={`download-artifact-${option.asset.id}`}
                      aria-pressed={index === 0 ? "true" : "false"}
                      data-variant-trigger={option.asset.id}
                    >
                      {option.variantLabel}
                    </button>
                  ))}
                </div>
              )}

              <div class="download-artifacts">
                {platform.options.map((option, optionIndex) => (
                  <article
                    class="download-artifact"
                    id={`download-artifact-${option.asset.id}`}
                    data-download-artifact-panel={option.asset.id}
                    data-initial-visible={optionIndex === 0 ? "" : undefined}
                  >
                    <p class="availability-state">
                      {option.asset.available ? "Package available" : "Package pending"}
                    </p>
                    <dl class="artifact-meta">
                      <div>
                        <dt>Architecture</dt>
                        <dd>{option.asset.arch}</dd>
                      </div>
                      <div>
                        <dt>Format</dt>
                        <dd>{option.formatLabel}</dd>
                      </div>
                      <div>
                        <dt>Size</dt>
                        <dd>{formatBytes(option.asset.sizeBytes)}</dd>
                      </div>
                      <div>
                        <dt>Signing</dt>
                        <dd>{formatSigningStatus(option.asset.signingStatus)}</dd>
                      </div>
                    </dl>

                    <div class="artifact-identity">
                      <div>
                        <span>Package</span>
                        <code>{option.asset.filename ?? "Filename pending"}</code>
                      </div>
                      <div class="checksum-row">
                        <span>SHA-256</span>
                        <code>{option.asset.sha256 ?? "Checksum pending"}</code>
                        {option.asset.sha256 && (
                          <button
                            type="button"
                            class="copy-checksum"
                            data-copy-checksum={option.asset.sha256}
                            aria-label={`Copy SHA-256 checksum for ${option.asset.platformLabel}`}
                          >
                            Copy
                          </button>
                        )}
                      </div>
                    </div>

                    <p class="canary-note">
                      <span aria-hidden="true">●</span>
                      {unsignedCanaryWarning}
                    </p>

                    {option.asset.available ? (
                      <a
                        class="download-primary"
                        href={option.asset.url}
                        aria-label={option.accessibleName}
                        data-download-asset={option.asset.id}
                      >
                        <span>Download {option.formatLabel}</span>
                        <span aria-hidden="true">↓</span>
                      </a>
                    ) : (
                      <span class="download-primary download-primary--pending">
                        Package pending
                      </span>
                    )}
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>

        <p class="selector-footnote">
          Need build receipts, SBOMs, or provenance? <a href={currentRelease.releaseUrl}>Open the release record</a>.
        </p>
        <p class="sr-only" aria-live="polite" data-copy-status></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { detectDesktopOperatingSystem } from "../lib/platform-detection";

  type NavigatorWithUAData = Navigator & {
    userAgentData?: { mobile?: boolean; platform?: string };
  };

  function readPlatformHints() {
    const navigatorWithUAData = navigator as NavigatorWithUAData;
    return {
      ...(navigatorWithUAData.userAgentData?.platform === undefined
        ? {}
        : { userAgentDataPlatform: navigatorWithUAData.userAgentData.platform }),
      ...(navigatorWithUAData.userAgentData?.mobile === undefined
        ? {}
        : { userAgentDataMobile: navigatorWithUAData.userAgentData.mobile }),
      navigatorPlatform: navigator.platform,
      userAgent: navigator.userAgent,
      maxTouchPoints: navigator.maxTouchPoints,
    };
  }

  document.querySelectorAll<HTMLElement>("[data-download-experience]").forEach((root) => {
    const tabs = Array.from(
      root.querySelectorAll<HTMLElement>("[data-platform-tab]"),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>("[data-platform-panel]"),
    );
    const tablist = root.querySelector<HTMLElement>("[data-platform-tabs]");
    const detectedPlatform = detectDesktopOperatingSystem(readPlatformHints());
    const fallbackPlatform = root.dataset.defaultPlatform ?? tabs[0]?.dataset.platformTab;
    const initialPlatform =
      detectedPlatform && tabs.some((tab) => tab.dataset.platformTab === detectedPlatform)
        ? detectedPlatform
        : fallbackPlatform;
    let platformWasManuallySelected = false;

    tablist?.setAttribute("role", "tablist");
    tabs.forEach((tab) => {
      const platform = tab.dataset.platformTab;
      if (!platform) return;
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", `download-panel-${platform}`);
    });
    panels.forEach((panel) => {
      const platform = panel.dataset.platformPanel;
      if (!platform) return;
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", `download-tab-${platform}`);
    });

    const animateElement = (element: HTMLElement) => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      element.removeAttribute("data-entering");
      void element.offsetWidth;
      element.setAttribute("data-entering", "");
      const finish = () => element.removeAttribute("data-entering");
      element.addEventListener("animationend", finish, { once: true });
      window.setTimeout(finish, 320);
    };

    const updateDetectedLabel = (platform: string) => {
      const label = root.querySelector<HTMLElement>("[data-detected-platform]");
      if (!label) return;
      const activePlatformIsDetected = detectedPlatform === platform;
      label.toggleAttribute("hidden", !activePlatformIsDetected);
    };

    const selectPlatform = (
      platform: string,
      options: { animate?: boolean; focus?: boolean; manual?: boolean } = {},
    ) => {
      const activePanel = panels.find(
        (panel) => panel.dataset.platformPanel === platform,
      );
      if (!activePanel) return;

      if (options.manual) platformWasManuallySelected = true;
      root.toggleAttribute("data-platform-manual", platformWasManuallySelected);
      root.dataset.downloadPlatform = platform;
      tabs.forEach((tab) => {
        const active = tab.dataset.platformTab === platform;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && options.focus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.toggleAttribute("hidden", panel !== activePanel);
      });
      updateDetectedLabel(platform);
      if (options.animate) animateElement(activePanel);
    };

    const selectVariant = (
      panel: HTMLElement,
      variant: string,
      animate = false,
    ) => {
      const triggers = Array.from(
        panel.querySelectorAll<HTMLButtonElement>("[data-variant-trigger]"),
      );
      const artifacts = Array.from(
        panel.querySelectorAll<HTMLElement>("[data-download-artifact-panel]"),
      );
      const activeArtifact = artifacts.find(
        (artifact) => artifact.dataset.downloadArtifactPanel === variant,
      );
      if (!activeArtifact) return;

      triggers.forEach((trigger) => {
        trigger.setAttribute(
          "aria-pressed",
          String(trigger.dataset.variantTrigger === variant),
        );
      });
      artifacts.forEach((artifact) => {
        artifact.toggleAttribute("hidden", artifact !== activeArtifact);
      });
      if (animate) animateElement(activeArtifact);
    };

    panels.forEach((panel) => {
      const firstVariant = panel.querySelector<HTMLButtonElement>(
        "[data-variant-trigger]",
      )?.dataset.variantTrigger;
      if (firstVariant) selectVariant(panel, firstVariant);

      panel.querySelectorAll<HTMLButtonElement>("[data-variant-trigger]").forEach(
        (trigger) => {
          trigger.addEventListener("click", () => {
            if (trigger.dataset.variantTrigger) {
              selectVariant(panel, trigger.dataset.variantTrigger, true);
            }
          });
        },
      );
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        const platform = tab.dataset.platformTab;
        if (platform) {
          selectPlatform(platform, { animate: true, focus: true, manual: true });
        }
      });

      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;
        event.preventDefault();
        const platform = tabs[nextIndex]?.dataset.platformTab;
        if (platform) {
          selectPlatform(platform, { animate: true, focus: true, manual: true });
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-copy-checksum]").forEach(
      (button) => {
        button.addEventListener("click", async () => {
          const checksum = button.dataset.copyChecksum;
          const status = root.querySelector<HTMLElement>("[data-copy-status]");
          if (!checksum) return;
          try {
            await navigator.clipboard.writeText(checksum);
            button.textContent = "Copied";
            if (status) status.textContent = "Checksum copied to clipboard.";
            window.setTimeout(() => {
              button.textContent = "Copy";
            }, 1600);
          } catch {
            if (status) status.textContent = "Copy failed. Select the checksum text instead.";
          }
        });
      },
    );

    if (initialPlatform) selectPlatform(initialPlatform);
    root.dataset.enhanced = "";
    if (detectedPlatform) root.dataset.detectedPlatform = detectedPlatform;
  });
</script>

<style>
  .download-experience {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-base);
  }

  .download-experience__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(32rem, 3fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .download-experience__copy {
    padding-top: clamp(1rem, 4vw, 3rem);
  }

  h1 {
    max-width: 9ch;
    font-family: var(--font-editorial);
    font-size: clamp(3.15rem, 6vw, 5.5rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.05em;
  }

  .lede {
    max-width: 31rem;
  }

  .release-summary {
    display: grid;
    gap: 0.75rem;
    margin: 2.25rem 0 0;
    padding: 1.15rem 0;
    border-block: 1px solid var(--border-subtle);
  }

  .release-summary div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .release-summary dt,
  .release-summary dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .release-summary dt {
    color: var(--text-faint);
  }

  .release-summary dd {
    color: var(--text-soft);
    overflow-wrap: anywhere;
  }

  .release-link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 1.35rem;
    color: var(--text-soft);
    font-size: 0.86rem;
    text-decoration: none;
  }

  .release-link:hover {
    color: var(--accent);
  }

  .download-experience__selector-wrap {
    position: relative;
    min-width: 0;
  }

  .download-experience__glow {
    position: absolute;
    top: 8%;
    right: -8%;
    bottom: 6%;
    left: 8%;
    border-radius: 42%;
    background: rgb(75 195 162 / 9%);
    filter: blur(54px);
    pointer-events: none;
  }

  .download-selector {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-raised) 96%, var(--secure-surface));
    box-shadow: var(--shadow-lift);
  }

  .download-selector__header {
    display: flex;
    min-height: 5.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem clamp(1.15rem, 3vw, 1.75rem);
    border-bottom: 1px solid var(--border-subtle);
  }

  .download-selector__kicker,
  .download-selector__title {
    margin: 0;
  }

  .download-selector__kicker {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .download-selector__title {
    color: var(--text-strong);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .detected-platform {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.35;
    text-align: right;
  }

  .platform-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-deep);
  }

  .platform-tab {
    display: flex;
    min-width: 0;
    min-height: 3.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.8rem;
    border-right: 1px solid var(--border-subtle);
    color: var(--text-soft);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
  }

  .platform-tab:last-child {
    border-right: 0;
  }

  .platform-tab[aria-selected="true"] {
    background: var(--surface-active);
    box-shadow: inset 0 -2px 0 var(--accent);
    color: var(--text-strong);
  }

  .platform-tab__mark {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .download-panels {
    min-height: 36rem;
  }

  .download-panel {
    display: grid;
    min-height: 36rem;
    align-content: start;
    padding: clamp(1.25rem, 3vw, 1.8rem);
  }

  @media (scripting: enabled) {
    [data-download-experience]:not([data-enhanced])
      [data-platform-panel]:not([data-initial-visible]),
    [data-download-experience]:not([data-enhanced])
      [data-download-artifact-panel]:not([data-initial-visible]) {
      display: none;
    }
  }

  [data-enhanced] [data-platform-panel][hidden],
  [data-enhanced] [data-download-artifact-panel][hidden] {
    display: none;
  }

  .download-panel + .download-panel {
    border-top: 1px solid var(--border-subtle);
  }

  [data-enhanced] .download-panel + .download-panel {
    border-top: 0;
  }

  .download-panel__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  .download-panel__heading p {
    margin: 0;
    font-size: 0.82rem;
  }

  .download-panel__platform {
    color: var(--text-strong);
    font-family: var(--font-ui);
    font-size: 1.35rem !important;
    font-weight: 500;
  }

  .availability-state {
    margin: 0 0 0.4rem;
    color: var(--secure);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: right;
  }

  .variant-selector {
    display: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-bottom: 1.15rem;
    padding: 0.35rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface-deep);
  }

  [data-enhanced] .variant-selector {
    display: grid;
  }

  .variant-selector button,
  .copy-checksum {
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  .variant-selector button {
    min-height: 2.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: calc(var(--radius-sm) - 2px);
    background: transparent;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .variant-selector button[aria-pressed="true"] {
    background: var(--surface-raised);
    box-shadow: 0 1px 4px rgb(23 33 31 / 9%);
    color: var(--text-strong);
  }

  .download-artifact + .download-artifact {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  [data-enhanced] .download-artifact + .download-artifact {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .artifact-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 1.15rem;
    border-block: 1px solid var(--border-subtle);
  }

  .artifact-meta div {
    min-width: 0;
    padding: 0.8rem 0.65rem 0.8rem 0;
  }

  .artifact-meta dt,
  .artifact-meta dd {
    margin: 0;
    font-family: var(--font-mono);
    line-height: 1.45;
  }

  .artifact-meta dt {
    color: var(--text-faint);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .artifact-meta dd {
    color: var(--text-soft);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  .artifact-identity {
    display: grid;
    gap: 0.85rem;
  }

  .artifact-identity > div {
    display: grid;
    min-width: 0;
    gap: 0.3rem;
  }

  .artifact-identity span,
  .artifact-identity code {
    font-family: var(--font-mono);
    line-height: 1.45;
  }

  .artifact-identity span {
    color: var(--text-faint);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .artifact-identity code {
    color: var(--text-soft);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .checksum-row {
    position: relative;
  }

  [data-enhanced] .checksum-row {
    padding-right: 4.2rem;
  }

  .copy-checksum {
    position: absolute;
    display: none;
    right: 0;
    bottom: 0;
    min-width: 3.4rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    background: var(--surface-deep);
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  [data-enhanced] .copy-checksum {
    display: block;
  }

  .canary-note {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 1.15rem 0;
    color: var(--warning-text);
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .canary-note span {
    color: var(--brand-coral);
    font-size: 0.65rem;
  }

  .download-primary {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--motion-quick);
  }

  .download-primary:hover {
    background: var(--brand-blue);
  }

  .download-primary--pending {
    border-color: var(--border-subtle);
    background: var(--surface-deep);
    color: var(--text-faint);
  }

  .selector-footnote {
    margin: 0;
    padding: 0.85rem clamp(1.25rem, 3vw, 1.8rem);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-faint);
    font-size: 0.72rem;
  }

  .selector-footnote a {
    color: var(--text-soft);
  }

  [data-entering] {
