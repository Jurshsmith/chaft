---
import { currentRelease, type ReleaseManifest } from "../data/releases";
interface Props { release?: ReleaseManifest; }
const { release = currentRelease } = Astro.props;
const hasSignedLinux = release.assets.some((asset) => asset.os === "linux" && asset.signingStatus === "signed");
---

<aside class="release-safety" role="note" data-release-warning>
  <strong>Preview safety</strong>
  <p><span>{hasSignedLinux ? "Canary." : "Unsigned canary."}</span> Unaudited. Do not use Chaft canary builds for sensitive or production communication.</p>
</aside>

<style>
  .release-safety {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.45rem 1rem;
    align-items: baseline;
    padding: 0.9rem 1rem;
    border: 1px solid var(--warning);
    border-radius: var(--radius-sm);
    background: var(--warning-surface);
  }

  .release-safety strong {
    color: var(--warning-text);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .release-safety p {
    margin: 0;
    color: var(--warning-text);
    font-size: 0.9rem;
  }

  .release-safety p span {
    font-weight: 600;
  }

  @media (max-width: 620px) {
    .release-safety {
      grid-template-columns: 1fr;
    }
  }
</style>
