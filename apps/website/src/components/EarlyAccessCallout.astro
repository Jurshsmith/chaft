---
import { sitePath } from "../lib/site-path";
---

<aside class="early-access" aria-labelledby="early-access-title">
  <div>
    <span class="status">Canary</span>
    <h2 id="early-access-title">Help test the thesis.</h2>
  </div>
  <div class="early-access__copy">
    <p>
      Chaft is experimental software. Public packages, production signing,
      notarization, and update delivery are still release gates.
    </p>
    <p>
      Use non-sensitive data. When reporting a problem, include your operating system
      and source revision, then remove credentials, local paths, and message content
      from logs.
    </p>
    <div class="button-row">
      <a class="button" href={sitePath("/docs/getting-started/build-desktop/")}>
        Build the canary
      </a>
      <a class="button button--secondary" href="https://github.com/Jurshsmith/chaft/issues">
        Report an issue
      </a>
      <a class="button button--quiet" href={sitePath("/security/")}>Security posture</a>
    </div>
  </div>
</aside>

<style>
  .early-access {
    --border-strong: #a85c47;
    --border-subtle: #d7a28f;
    --surface-active: #f1cfc2;
    --text-faint: #815144;
    --text-muted: #713829;
    --text-soft: #492820;
    --text-strong: #321c17;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(2rem, 6vw, 4rem);
    border: 1px solid var(--warning);
    border-radius: var(--radius-md);
    background: var(--warning-surface);
    box-shadow: 7px 8px 0 color-mix(in srgb, var(--brand-coral) 22%, transparent);
  }

  h2 {
    margin-top: 1.4rem;
    margin-bottom: 0;
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .early-access__copy {
    align-self: end;
  }

  .early-access__copy p {
    color: var(--warning-text);
  }

  .early-access__copy .button-row {
    margin-top: 0.8rem;
  }

  @media (max-width: 760px) {
    .early-access {
      grid-template-columns: 1fr;
    }
  }
</style>
