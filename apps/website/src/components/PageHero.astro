---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
const hasActions = Astro.slots.has("default");
---

<section class="page-hero">
  <div class="shell page-hero__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    {hasActions && (
      <div class="page-hero__actions">
        <slot />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-base);
  }

  .page-hero::before,
  .page-hero::after {
    position: absolute;
    content: "";
  }

  .page-hero::before {
    top: 42%;
    right: max(4rem, calc((100vw - var(--content-width)) / 2 + 3rem));
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: var(--brand-coral);
    box-shadow:
      6.5rem -4.5rem 0 var(--accent),
      11.5rem 3.8rem 0 var(--brand-violet);
  }

  .page-hero::after {
    top: 50%;
    right: max(-4rem, calc((100vw - var(--content-width)) / 2 - 2rem));
    width: clamp(15rem, 27vw, 23rem);
    height: clamp(15rem, 27vw, 23rem);
    transform: translateY(-50%);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: transparent;
    box-shadow:
      inset 0 0 0 clamp(3rem, 6vw, 5rem) rgb(8 118 91 / 4%),
      0 0 0 clamp(2rem, 4vw, 3.5rem) color-mix(in srgb, var(--brand-coral) 4%, transparent);
    opacity: 0.78;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
  }

  h1 {
    max-width: 11ch;
    font-family: var(--font-editorial);
    font-size: clamp(3.1rem, 7vw, 5.8rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .page-hero__actions {
    margin-top: 2rem;
  }

  @media (max-width: 760px) {
    .page-hero::before {
      right: 0;
      opacity: 0.38;
    }

    .page-hero::after {
      right: -8rem;
      opacity: 0.32;
    }
  }
</style>
