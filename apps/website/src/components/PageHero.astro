---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
const hasActions = Astro.slots.has("default");
---

<section class="page-hero">
  <div class="shell page-hero__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    {hasActions && (
      <div class="page-hero__actions">
        <slot />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 8rem);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-deep);
  }

  .page-hero::after {
    position: absolute;
    top: 50%;
    right: max(-8rem, calc((100vw - var(--content-width)) / 2));
    width: clamp(14rem, 32vw, 30rem);
    height: clamp(14rem, 32vw, 30rem);
    transform: translateY(-50%);
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    background: var(--surface-base);
    opacity: 0.55;
    content: "";
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
  }

  h1 {
    max-width: 11ch;
    font-size: clamp(3.2rem, 8vw, 6.8rem);
  }

  .page-hero__actions {
    margin-top: 2rem;
  }
</style>
