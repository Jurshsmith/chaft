---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  variant?: "default" | "compact" | "split";
}

const { eyebrow, title, lede, variant = "default" } = Astro.props;
const hasActions = Astro.slots.has("default");
const hasVisual = Astro.slots.has("visual");
const hasMeta = Astro.slots.has("meta");
---

<section class:list={["page-hero", `page-hero--${variant}`]}>
  <div class="shell page-hero__grid">
    <div class="page-hero__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      {hasActions && <div class="page-hero__actions"><slot /></div>}
      {hasMeta && <div class="page-hero__meta"><slot name="meta" /></div>}
    </div>
    {hasVisual && <div class="page-hero__visual"><slot name="visual" /></div>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--border-subtle);
    background:
      radial-gradient(circle at 86% 22%, rgb(7 112 84 / 8%), transparent 24rem),
      var(--surface-base);
  }

  .page-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .page-hero--split .page-hero__grid {
    grid-template-columns: minmax(0, 0.92fr) minmax(24rem, 1.08fr);
  }

  .page-hero--compact {
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
  }

  .page-hero__copy {
    position: relative;
    z-index: 1;
    max-width: 50rem;
  }

  h1 {
    max-width: 13ch;
    font-size: clamp(2.8rem, 6vw, 5.15rem);
    text-wrap: balance;
  }

  .page-hero--compact h1 {
    font-size: clamp(2.65rem, 5vw, 4.4rem);
  }

  .lede {
    max-width: 42rem;
    margin-bottom: 0;
  }

  .page-hero__actions {
    margin-top: 2rem;
  }

  .page-hero__meta {
    margin-top: 1.5rem;
  }

  .page-hero__visual {
    min-width: 0;
  }

  @media (max-width: 860px) {
    .page-hero--split .page-hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
