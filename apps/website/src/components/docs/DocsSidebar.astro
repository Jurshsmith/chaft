---
import {
  DOC_SECTION_ORDER,
  docRoutePath,
  groupDocsBySection,
  type DocNavigationEntry,
} from "../../lib/docs";
import { sitePath } from "../../lib/site-path";

interface Props {
  entries: DocNavigationEntry[];
  currentId?: string;
}

const { entries, currentId } = Astro.props;
const groupedEntries = new Map(
  groupDocsBySection(entries).map((group) => [group.section, group] as const),
);
const groups = DOC_SECTION_ORDER.flatMap((section) => {
  const group = groupedEntries.get(section);
  return group ? [group] : [];
});
---

<aside class="docs-sidebar docs-sidebar--desktop">
  <a
    class="docs-sidebar__home"
    href={sitePath("/docs/")}
    aria-current={currentId === "index" ? "page" : undefined}
  >
    Documentation
  </a>
  <nav aria-label="Documentation navigation">
    {groups.map((group) => (
      <div
        class="docs-sidebar__group"
        role="group"
        aria-labelledby={`docs-section-${group.section}`}
      >
        <p class="docs-sidebar__section-title" id={`docs-section-${group.section}`}>
          {group.label}
        </p>
        <ul>
          {group.entries.map((entry) => (
            <li>
              <a
                href={sitePath(docRoutePath(entry.id))}
                aria-current={entry.id === currentId ? "page" : undefined}
              >
                {entry.data.navTitle ?? entry.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<details class="docs-sidebar docs-sidebar--mobile">
  <summary>Browse documentation</summary>
  <nav aria-label="Documentation navigation">
    <a
      class="docs-sidebar__overview"
      href={sitePath("/docs/")}
      aria-current={currentId === "index" ? "page" : undefined}
    >
      Documentation overview
    </a>
    {groups.map((group) => (
      <div
        class="docs-sidebar__group"
        role="group"
        aria-labelledby={`mobile-docs-section-${group.section}`}
      >
        <p
          class="docs-sidebar__section-title"
          id={`mobile-docs-section-${group.section}`}
        >
          {group.label}
        </p>
        <ul>
          {group.entries.map((entry) => (
            <li>
              <a
                href={sitePath(docRoutePath(entry.id))}
                aria-current={entry.id === currentId ? "page" : undefined}
              >
                {entry.data.navTitle ?? entry.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</details>

<style>
  .docs-sidebar {
    min-width: 0;
  }

  .docs-sidebar--desktop {
    position: sticky;
    top: 1.5rem;
    max-height: calc(100vh - 3rem);
    overflow: auto;
    padding-right: 1.1rem;
  }

  .docs-sidebar__home {
    display: block;
    margin-bottom: 1.4rem;
    color: var(--text-strong);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }

  .docs-sidebar__home[aria-current="page"] {
    color: var(--accent);
  }

  .docs-sidebar nav {
    display: grid;
    gap: 1.45rem;
  }

  .docs-sidebar__group {
    min-width: 0;
  }

  .docs-sidebar__section-title {
    max-width: none;
    margin-bottom: 0.55rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .docs-sidebar ul {
    display: grid;
    gap: 0.12rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-sidebar li {
    min-width: 0;
  }

  .docs-sidebar li a {
    display: block;
    padding: 0.43rem 0.55rem;
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius-xs) var(--radius-xs) 0;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .docs-sidebar li a:hover {
    color: var(--text-strong);
  }

  .docs-sidebar li a[aria-current="page"] {
    border-left-color: var(--accent);
    background: var(--secure-surface);
    color: var(--text-strong);
  }

  .docs-sidebar--mobile {
    display: none;
    grid-column: 1 / -1;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .docs-sidebar--mobile summary {
    padding: 0.8rem 1rem;
    color: var(--text-soft);
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .docs-sidebar--mobile[open] summary {
    border-bottom: 1px solid var(--border-subtle);
  }

  .docs-sidebar--mobile nav {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 1rem;
  }

  .docs-sidebar__overview {
    grid-column: 1 / -1;
    color: var(--text-soft);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
  }

  .docs-sidebar__overview:hover,
  .docs-sidebar__overview[aria-current="page"] {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .docs-sidebar--desktop {
      display: none;
    }

    .docs-sidebar--mobile {
      display: block;
    }
  }

  @media (max-width: 580px) {
    .docs-sidebar--mobile nav {
      grid-template-columns: 1fr;
    }
  }
</style>
