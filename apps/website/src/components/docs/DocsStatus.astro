---
interface Props {
  section: string;
  status: string;
  audience: string;
}

const { section, status, audience } = Astro.props;

const statusLabels: Record<string, string> = {
  canary: "Canary",
  stable: "Stable",
  deprecated: "Deprecated",
};

const sectionLabels: Record<string, string> = {
  "getting-started": "Getting started",
  concepts: "Concept",
  development: "Development",
  reference: "Reference",
};

const audienceLabels: Record<string, string> = {
  users: "For users",
  contributors: "For contributors",
  operators: "For operators",
};

const statusLabel = statusLabels[status] ?? status;
const sectionLabel = sectionLabels[section] ?? section;
const audienceLabel = audienceLabels[audience] ?? audience;
---

<div class="docs-status" aria-label={`${sectionLabel}; ${statusLabel}; ${audienceLabel}`}>
  <span>{sectionLabel}</span>
  <span class:list={[`docs-status__state`, `docs-status__state--${status}`]}>
    {statusLabel}
  </span>
  <span>{audienceLabel}</span>
</div>

<style>
  .docs-status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .docs-status span {
    display: inline-flex;
    align-items: center;
  }

  .docs-status span + span {
    gap: 0.4rem;
  }

  .docs-status span + span::before {
    color: var(--border-strong);
    content: "/";
  }

  .docs-status__state::after {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--warning);
    content: "";
  }

  .docs-status__state--stable::after {
    background: var(--success);
  }
</style>
