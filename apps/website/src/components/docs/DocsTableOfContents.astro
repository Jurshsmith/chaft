---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth === 2);
const isLong = visibleHeadings.length > 6;
---

{visibleHeadings.length > 0 && (
  isLong ? (
    <details class="docs-toc docs-toc--collapsible">
      <summary>On this page · {visibleHeadings.length} sections</summary>
      <nav aria-label="On this page">
        <ol>
          {visibleHeadings.map((heading) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ) : (
    <nav class="docs-toc" aria-label="On this page">
      <p>On this page</p>
      <ol>
        {visibleHeadings.map((heading) => (
          <li>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
)}

<style>
  .docs-toc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem 1rem;
    align-items: start;
    margin-bottom: 2rem;
    padding-block: 0.85rem;
    border-block: 1px solid var(--border-subtle);
  }

  .docs-toc > p {
    margin: 0;
    padding-top: 0.2rem;
    color: var(--warning);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .docs-toc--collapsible {
    display: block;
  }

  .docs-toc--collapsible summary {
    cursor: pointer;
    color: var(--warning);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .docs-toc--collapsible summary:focus-visible {
    border-radius: var(--radius-sm);
    outline: 2px solid var(--accent);
    outline-offset: 0.25rem;
  }

  .docs-toc--collapsible ol {
    margin-top: 0.85rem;
  }

  .docs-toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-toc li {
    line-height: 1.35;
  }

  .docs-toc a {
    display: block;
    padding-block: 0.18rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    text-decoration-color: var(--border-strong);
  }

  .docs-toc a:hover {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .docs-toc {
      grid-template-columns: 1fr;
    }
  }
</style>
