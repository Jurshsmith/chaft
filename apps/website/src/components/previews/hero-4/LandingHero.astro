---
import LandingHeroCopy from "../../landing/LandingHeroCopy.astro";
import HeroFourPixelField from "./HeroFourPixelField.astro";

interface Props {
  hasPublishedDownloads: boolean;
}

const { hasPublishedDownloads } = Astro.props;
---

<section class="hero" data-chaft-hero="hero-4">
  <HeroFourPixelField />

  <div class="shell hero__grid">
    <LandingHeroCopy {hasPublishedDownloads} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(43rem, 78vh, 52rem);
    overflow: hidden;
    align-items: center;
    padding-block: clamp(5.5rem, 11vw, 8rem);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-base);
  }

  .hero::after {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 8rem;
    background: linear-gradient(transparent, rgb(244 241 232 / 72%));
    content: "";
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 2;
  }

  .hero :global(.hero__copy) {
    position: relative;
    width: min(100%, 44rem);
  }

  .hero :global(h1) {
    max-width: 10.5ch;
    margin-bottom: 1.8rem;
    color: var(--text-strong);
    font-size: clamp(3.4rem, 7.5vw, 6.4rem);
    text-wrap: balance;
  }

  .hero :global(h1 em) {
    display: block;
    color: var(--accent);
    font-family: var(--font-editorial);
    font-size: 1.04em;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .hero :global(.hero__actions) {
    margin-top: 2.25rem;
  }

  .hero :global(.eyebrow) {
    color: var(--accent);
  }

  .hero :global(.eyebrow::before) {
    background: var(--brand-coral);
    box-shadow: 0 0 1.2rem rgb(216 86 63 / 24%);
  }

  .hero :global(.lede) {
    color: var(--text-soft);
  }

  .hero :global(.button) {
    background: var(--accent);
    color: var(--on-accent);
  }

  .hero :global(.button:hover) {
    background: #075f49;
    box-shadow: 4px 4px 0 rgb(23 33 31 / 16%);
  }

  .hero :global(.button--secondary) {
    border-color: var(--border-subtle);
    background: rgb(255 253 247 / 72%);
    color: var(--text-strong);
    backdrop-filter: blur(8px);
  }

  .hero :global(.button--secondary:hover) {
    border-color: var(--border-strong);
    background: var(--surface-raised);
  }

  .hero :global(.button--quiet) {
    background: transparent;
    color: var(--text-strong);
    text-decoration-color: rgb(23 33 31 / 36%);
  }

  .hero :global(.button--quiet:hover) {
    background: transparent;
    color: var(--accent);
  }

  .hero :global(.hero__note) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
    margin-top: 2rem;
    margin-bottom: 0;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .hero :global(.status) {
    border-color: var(--border-subtle);
    background: rgb(255 253 247 / 68%);
    color: var(--text-strong);
    backdrop-filter: blur(8px);
  }

  @media (max-width: 680px) {
    .hero {
      min-height: 48rem;
      align-items: start;
      padding-block: 5rem 7rem;
    }

    .hero :global(h1) {
      font-size: clamp(3rem, 15vw, 4.75rem);
    }
  }
</style>
