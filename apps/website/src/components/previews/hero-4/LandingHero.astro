---
import LandingHeroCopy from "../../landing/LandingHeroCopy.astro";
import HeroFourPixelField from "./HeroFourPixelField.astro";

interface Props {
  hasPublishedDownloads: boolean;
}

const { hasPublishedDownloads } = Astro.props;
---

<section class="hero" data-chaft-hero="hero-4">
  <HeroFourPixelField />

  <div class="shell hero__grid">
    <LandingHeroCopy {hasPublishedDownloads} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(43rem, 78vh, 52rem);
    overflow: hidden;
    align-items: center;
    padding-block: clamp(5.5rem, 11vw, 8rem);
    border-bottom: 1px solid var(--border-subtle);
    background: #071737;
  }

  .hero::after {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 8rem;
    background: linear-gradient(transparent, rgb(3 14 38 / 48%));
    content: "";
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 2;
  }

  .hero :global(.hero__copy) {
    position: relative;
    width: min(100%, 44rem);
  }

  .hero :global(h1) {
    max-width: 10.5ch;
    margin-bottom: 1.8rem;
    color: #f7fbff;
    font-size: clamp(3.4rem, 7.5vw, 6.4rem);
    text-wrap: balance;
  }

  .hero :global(h1 em) {
    display: block;
    color: #a9d5ff;
    font-family: var(--font-editorial);
    font-size: 1.04em;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .hero :global(.hero__actions) {
    margin-top: 2.25rem;
  }

  .hero :global(.eyebrow) {
    color: #a9d5ff;
  }

  .hero :global(.eyebrow::before) {
    background: #f7fbff;
    box-shadow: 0 0 1.2rem rgb(226 244 255 / 80%);
  }

  .hero :global(.lede) {
    color: #d3e6f7;
  }

  .hero :global(.button) {
    background: #f7fbff;
    color: #09265b;
  }

  .hero :global(.button:hover) {
    background: #dceeff;
    box-shadow: 4px 4px 0 rgb(0 9 30 / 34%);
  }

  .hero :global(.button--secondary) {
    border-color: rgb(211 230 247 / 62%);
    background: rgb(5 20 53 / 34%);
    color: #f7fbff;
    backdrop-filter: blur(8px);
  }

  .hero :global(.button--secondary:hover) {
    border-color: #f7fbff;
    background: rgb(169 213 255 / 16%);
  }

  .hero :global(.button--quiet) {
    background: transparent;
    color: #d3e6f7;
    text-decoration-color: rgb(211 230 247 / 55%);
  }

  .hero :global(.button--quiet:hover) {
    background: transparent;
    color: #fff;
  }

  .hero :global(.hero__note) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
    margin-top: 2rem;
    margin-bottom: 0;
    color: #bdd4e8;
    font-size: 0.8rem;
  }

  .hero :global(.status) {
    border-color: rgb(211 230 247 / 32%);
    background: rgb(5 20 53 / 46%);
    color: #f7fbff;
    backdrop-filter: blur(8px);
  }

  @media (max-width: 680px) {
    .hero {
      min-height: 48rem;
      align-items: start;
      padding-block: 5rem 7rem;
    }

    .hero :global(h1) {
      font-size: clamp(3rem, 15vw, 4.75rem);
    }
  }
</style>
