---
import LandingHeroCopy from "../../landing/LandingHeroCopy.astro";
import CommunicationSurfaceVisual from "./CommunicationSurfaceVisual.astro";

interface Props {
  hasPublishedDownloads: boolean;
}

const { hasPublishedDownloads } = Astro.props;
---

<section class="hero" data-chaft-hero="hero-2">
  <div class="shell hero__grid">
    <LandingHeroCopy {hasPublishedDownloads} />

    <div class="hero__visual">
      <CommunicationSurfaceVisual />
    </div>
  </div>
</section>

<style>
  .hero {
    --accent: #0b6f54;
    --border-strong: #a9afa8;
    --border-subtle: #d7d3c8;
    --on-accent: #fffdf7;
    --surface-active: #e4e9e2;
    --text-faint: #68716c;
    --text-muted: #59635f;
    --text-soft: #36413d;
    --text-strong: #17211f;
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.75rem, 4.5vw, 5.25rem);
    border-bottom: 1px solid var(--border-subtle);
    background:
      radial-gradient(circle at 76% 45%, rgb(92 151 125 / 12%), transparent 32rem),
      radial-gradient(circle at 94% 24%, rgb(255 253 247 / 86%), transparent 23rem),
      linear-gradient(115deg, #f8f5ed 0%, #f5f1e8 56%, #efede4 100%);
    color: var(--text-strong);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 13% 31%, rgb(23 33 31 / 7%) 0 0.55px, transparent 0.8px),
      radial-gradient(circle at 72% 67%, rgb(23 33 31 / 5%) 0 0.5px, transparent 0.75px);
    background-size:
      19px 23px,
      29px 31px;
    mask-image: linear-gradient(to right, transparent 2%, #000 44%, #000 96%, transparent);
    opacity: 0.48;
    pointer-events: none;
    content: "";
  }

  .hero::after {
    position: absolute;
    top: 10%;
    right: clamp(-12rem, -7vw, -5rem);
    width: clamp(25rem, 44vw, 42rem);
    aspect-ratio: 1.4;
    border: 1px solid rgb(23 33 31 / 5%);
    border-radius: 50%;
    transform: rotate(-9deg);
    pointer-events: none;
    content: "";
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(29rem, 1.04fr);
    gap: clamp(2.5rem, 4vw, 4rem);
    align-items: center;
  }

  .hero :global(.hero__copy) {
    position: relative;
    z-index: 2;
  }

  .hero :global(h1) {
    max-width: 9ch;
    margin-bottom: 1.8rem;
    color: var(--text-strong);
    font-size: clamp(3.35rem, 5vw, 4.5rem);
  }

  .hero :global(h1 em) {
    display: block;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    font-style: normal;
    font-weight: inherit;
    letter-spacing: inherit;
  }

  .hero :global(.eyebrow) {
    color: var(--accent);
  }

  .hero :global(.eyebrow::before) {
    background: var(--accent);
    box-shadow: 0 0 0 0.28rem rgb(11 111 84 / 9%);
  }

  .hero :global(.lede) {
    max-width: 39rem;
    color: var(--text-muted);
  }

  .hero :global(.hero__actions) {
    margin-top: 1.75rem;
  }

  .hero :global(.hero__note) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
    margin-top: 1.4rem;
    margin-bottom: 0;
    color: var(--text-faint);
    font-size: 0.8rem;
  }

  .hero__visual {
    position: relative;
    min-width: 0;
  }

  .hero__visual::before {
    position: absolute;
    top: 9%;
    right: -7%;
    bottom: 7%;
    left: 17%;
    z-index: -1;
    border-radius: 50%;
    background: rgb(90 145 120 / 8%);
    filter: blur(48px);
    content: "";
  }

  .hero :global(.button) {
    background: var(--text-strong);
    color: var(--on-accent);
  }

  .hero :global(.button:hover) {
    background: var(--accent);
  }

  .hero :global(.button--secondary) {
    border-color: var(--border-strong);
    background: transparent;
    color: var(--text-strong);
  }

  .hero :global(.button--secondary:hover) {
    border-color: var(--accent);
    background: var(--surface-active);
  }

  .hero :global(.button--quiet) {
    background: transparent;
    color: var(--text-soft);
    text-decoration-color: var(--border-strong);
  }

  .hero :global(.button--quiet:hover) {
    background: transparent;
    color: var(--accent);
  }

  .hero :global(.status) {
    border-color: var(--border-subtle);
    background: rgb(255 253 247 / 52%);
    color: var(--text-soft);
  }

  @media (max-width: 1020px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      width: min(100%, 45rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-block: 3.25rem 4.25rem;
    }

    .hero__grid {
      gap: 2.75rem;
    }

    .hero :global(h1) {
      font-size: clamp(3rem, 16vw, 4.35rem);
    }
  }
</style>
