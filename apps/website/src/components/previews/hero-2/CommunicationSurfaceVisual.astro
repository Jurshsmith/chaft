---
const bandSettings = [
  { baseY: 35, phase: 0.2, amplitude: 7.2 },
  { baseY: 50, phase: 0.95, amplitude: 5.8 },
  { baseY: 65, phase: 1.75, amplitude: 7.6 },
];

const particleBands = bandSettings.map((band, bandIndex) =>
  Array.from({ length: 30 }, (_, index) => {
    const progress = (index + 0.5) / 30;
    const convergence = Math.exp(-Math.pow((progress - 0.67) / 0.18, 2));
    const naturalY =
      band.baseY +
      Math.sin(progress * Math.PI * 1.8 + band.phase) * band.amplitude +
      Math.cos(progress * Math.PI * 4 + bandIndex) * 1.1;
    const y = naturalY * (1 - convergence * 0.34) + 48 * convergence * 0.34;

    return {
      x: Number((2.5 + progress * 95).toFixed(2)),
      y: Number(y.toFixed(2)),
      size: Number((1.7 + ((index * 7 + bandIndex * 3) % 9) * 0.15).toFixed(2)),
      opacity: Number((0.18 + ((index * 5 + bandIndex) % 8) * 0.055).toFixed(2)),
    };
  }),
);
---

<div
  class="communication-surface"
  role="img"
  aria-label="A calm field of direct device communication converging on one trusted peer"
>
  <div class="communication-surface__plane" aria-hidden="true"></div>

  <div class="communication-surface__routes" aria-hidden="true">
    <span class="communication-surface__route communication-surface__route--upper"></span>
    <span class="communication-surface__route communication-surface__route--middle"></span>
    <span class="communication-surface__route communication-surface__route--lower"></span>
  </div>

  {
    particleBands.map((particles, bandIndex) => (
      <div
        class={`communication-surface__particles communication-surface__particles--${bandIndex + 1}`}
        aria-hidden="true"
      >
        {particles.map((particle) => (
          <span
            class="communication-surface__particle"
            style={`--particle-x: ${particle.x}%; --particle-y: ${particle.y}%; --particle-size: ${particle.size}px; --particle-opacity: ${particle.opacity}`}
          ></span>
        ))}
      </div>
    ))
  }

  <div class="communication-surface__node" aria-hidden="true">
    <span class="communication-surface__node-halo"></span>
    <span class="communication-surface__node-core"></span>
    <span class="communication-surface__node-label">trusted peer</span>
  </div>

  <div class="surface-card surface-card--channel" aria-hidden="true">
    <span class="surface-card__label">Peer channel</span>
    <strong><span class="surface-card__status"></span>Direct · online</strong>
    <small>3 trusted devices</small>
  </div>

  <div class="surface-card surface-card--message" aria-hidden="true">
    <span class="surface-card__label">Message 0842</span>
    <strong>Encrypted locally</strong>
    <span class="surface-card__line surface-card__line--long"></span>
    <span class="surface-card__line"></span>
  </div>

  <div class="surface-card surface-card--history" aria-hidden="true">
    <span class="surface-card__label">Device history</span>
    <strong>In sync</strong>
    <small>latest event · 08:42</small>
  </div>
</div>

<style>
  .communication-surface {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: clamp(31rem, 46vw, 37rem);
    overflow: hidden;
    border-radius: clamp(1.4rem, 3vw, 2.4rem);
    background:
      radial-gradient(circle at 66% 48%, rgb(41 129 98 / 11%), transparent 5rem),
      radial-gradient(circle at 56% 52%, rgb(255 253 247 / 92%), transparent 22rem),
      linear-gradient(145deg, rgb(255 253 247 / 28%), rgb(231 230 220 / 18%));
    contain: layout paint;
  }

  .communication-surface::before,
  .communication-surface::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: "";
  }

  .communication-surface::before {
    background:
      radial-gradient(circle at 19% 27%, rgb(23 33 31 / 12%) 0 0.7px, transparent 1px),
      radial-gradient(circle at 71% 74%, rgb(23 33 31 / 8%) 0 0.65px, transparent 0.95px);
    background-size:
      27px 31px,
      41px 37px;
    opacity: 0.42;
  }

  .communication-surface::after {
    background: linear-gradient(
      90deg,
      rgb(248 245 237 / 88%) 0%,
      transparent 14%,
      transparent 87%,
      rgb(240 237 228 / 62%) 100%
    );
  }

  .communication-surface__plane {
    position: absolute;
    top: 19%;
    right: 4%;
    bottom: 14%;
    left: 8%;
    z-index: 0;
    transform: perspective(700px) rotateX(61deg) rotateZ(-4deg);
    transform-origin: center;
    border: 1px solid rgb(23 33 31 / 6%);
    border-radius: 50%;
    background-image:
      linear-gradient(rgb(23 33 31 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(23 33 31 / 3%) 1px, transparent 1px);
    background-size: 2rem 2rem;
    mask-image: radial-gradient(ellipse, #000 18%, transparent 72%);
    opacity: 0.72;
  }

  .communication-surface__routes,
  .communication-surface__particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .communication-surface__routes {
    z-index: 1;
    animation: surface-path-drift 22s ease-in-out infinite alternate;
  }

  .communication-surface__route {
    position: absolute;
    display: block;
    border-top: 1px solid rgb(79 91 85 / 22%);
    border-radius: 50% 50% 0 0;
    transform-origin: 66% 50%;
  }

  .communication-surface__route--upper {
    top: 34%;
    left: -13%;
    width: 124%;
    height: 41%;
    transform: rotate(6deg);
    opacity: 0.72;
  }

  .communication-surface__route--middle {
    top: 48%;
    left: -11%;
    width: 124%;
    height: 31%;
    border-top-color: rgb(65 79 73 / 31%);
    transform: rotate(-1deg);
  }

  .communication-surface__route--lower {
    top: 57%;
    left: -9%;
    width: 119%;
    height: 50%;
    transform: rotate(-11deg);
    opacity: 0.64;
  }

  .communication-surface__particles {
    z-index: 2;
    animation: surface-particle-drift 24s ease-in-out infinite alternate;
  }

  .communication-surface__particles--2 {
    animation-delay: -8s;
    animation-duration: 28s;
  }

  .communication-surface__particles--3 {
    animation-delay: -15s;
    animation-duration: 31s;
  }

  .communication-surface__particle {
    position: absolute;
    top: var(--particle-y);
    left: var(--particle-x);
    width: var(--particle-size);
    height: var(--particle-size);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #43504b;
    opacity: var(--particle-opacity);
    box-shadow: 0 0 0 0.5px rgb(255 253 247 / 55%);
  }

  .communication-surface__node {
    position: absolute;
    top: 48%;
    left: 66.5%;
    z-index: 5;
    width: 0;
    height: 0;
  }

  .communication-surface__node-halo,
  .communication-surface__node-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
  }

  .communication-surface__node-halo {
    width: 4.25rem;
    height: 4.25rem;
    border: 1px solid rgb(11 111 84 / 18%);
    background: rgb(11 111 84 / 5%);
    animation: surface-node-breathe 8s ease-in-out infinite;
  }

  .communication-surface__node-core {
    width: 0.72rem;
    height: 0.72rem;
    border: 2px solid #fffdf7;
    background: #0b7658;
    box-shadow:
      0 0 0 0.28rem rgb(11 118 88 / 12%),
      0 0 1.4rem rgb(11 118 88 / 22%);
  }

  .communication-surface__node-label {
    position: absolute;
    top: 1.25rem;
    left: 0.9rem;
    width: max-content;
    color: #53605b;
    font-family: var(--font-ui);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .surface-card {
    position: absolute;
    z-index: 4;
    display: grid;
    gap: 0.32rem;
    width: clamp(9.4rem, 15vw, 11.5rem);
    padding: 0.78rem 0.85rem;
    border: 1px solid rgb(23 33 31 / 10%);
    border-radius: 0.85rem;
    background: rgb(255 253 247 / 78%);
    box-shadow:
      0 1.2rem 3rem rgb(23 33 31 / 7%),
      inset 0 1px 0 rgb(255 255 255 / 62%);
    backdrop-filter: blur(12px);
    color: #17211f;
    animation: surface-card-drift 20s ease-in-out infinite alternate;
  }

  .surface-card--channel {
    top: 13%;
    left: 4%;
    animation-delay: -5s;
  }

  .surface-card--message {
    top: 18%;
    right: 1.5%;
    width: clamp(10.5rem, 17vw, 12.8rem);
    animation-delay: -12s;
    animation-duration: 24s;
  }

  .surface-card--history {
    bottom: 11%;
    left: 18%;
    animation-delay: -9s;
    animation-duration: 23s;
  }

  .surface-card__label,
  .surface-card small {
    color: #6d7772;
    font-family: var(--font-ui);
    font-size: 0.59rem;
    line-height: 1.35;
  }

  .surface-card__label {
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .surface-card strong {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .surface-card__status {
    width: 0.42rem;
    height: 0.42rem;
    flex: 0 0 0.42rem;
    border-radius: 50%;
    background: #0b7658;
    box-shadow: 0 0 0 0.2rem rgb(11 118 88 / 9%);
  }

  .surface-card__line {
    display: block;
    width: 58%;
    height: 2px;
    margin-top: 0.12rem;
    border-radius: 999px;
    background: rgb(23 33 31 / 13%);
  }

  .surface-card__line--long {
    width: 88%;
  }

  @keyframes surface-path-drift {
    from {
      transform: translate3d(-3px, 1px, 0);
      opacity: 0.78;
    }

    to {
      transform: translate3d(4px, -1px, 0);
      opacity: 1;
    }
  }

  @keyframes surface-particle-drift {
    from {
      transform: translate3d(-2px, 1px, 0);
      opacity: 0.78;
    }

    to {
      transform: translate3d(4px, -2px, 0);
      opacity: 1;
    }
  }

  @keyframes surface-node-breathe {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(0.96);
      opacity: 0.58;
    }

    50% {
      transform: translate(-50%, -50%) scale(1.05);
      opacity: 0.9;
    }
  }

  @keyframes surface-card-drift {
    from {
      transform: translate3d(0, -2px, 0);
    }

    to {
      transform: translate3d(0, 3px, 0);
    }
  }

  @media (max-width: 1020px) {
    .communication-surface {
      min-height: clamp(30rem, 76vw, 37rem);
    }
  }

  @media (max-width: 600px) {
    .communication-surface {
      min-height: clamp(24rem, 112vw, 29rem);
      border-radius: 1.25rem;
    }

    .surface-card {
      width: 8.75rem;
      padding: 0.66rem 0.7rem;
    }

    .surface-card--message {
      width: 9.6rem;
    }

    .surface-card--history {
      display: none;
    }

    .communication-surface__node {
      left: 64%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .communication-surface__routes,
    .communication-surface__particles,
    .communication-surface__node-halo,
    .surface-card {
      animation: none;
    }
  }
</style>
