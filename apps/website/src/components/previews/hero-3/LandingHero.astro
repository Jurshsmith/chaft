---
import LandingHeroCopy from "../../landing/LandingHeroCopy.astro";

interface Props {
  hasPublishedDownloads: boolean;
}

const { hasPublishedDownloads } = Astro.props;
---

<section class="hero hero--preview-three" data-chaft-hero="hero-3">
  <div
    class="signal-sphere"
    data-hero-three
    role="img"
    aria-label="A spherical field of connected peers with quiet message activity"
  >
    <canvas aria-hidden="true"></canvas>
    <div class="signal-sphere__halo" aria-hidden="true"></div>
    <div class="signal-sphere__activity" aria-hidden="true">
      <span class="signal-sphere__message signal-sphere__message--one">
        <i></i>
        <b>Direct sync</b>
        <small>2 peers reachable</small>
      </span>
      <span class="signal-sphere__message signal-sphere__message--two">
        <i></i>
        <b>History verified</b>
        <small>local copy current</small>
      </span>
      <span class="signal-sphere__message signal-sphere__message--three">
        <i></i>
        <b>New message</b>
        <small>encrypted content</small>
      </span>
    </div>
  </div>

  <div class="shell hero__grid">
    <LandingHeroCopy {hasPublishedDownloads} />
  </div>
</section>

<script>
  type SpherePoint = {
    x: number;
    y: number;
    z: number;
    size: number;
    phase: number;
  };

  type ProjectedPoint = {
    x: number;
    y: number;
    z: number;
    scale: number;
  };

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const interactivePointer = window.matchMedia(
    "(hover: hover) and (pointer: fine)",
  );

  for (const root of document.querySelectorAll("[data-hero-three]")) {
    if (!(root instanceof HTMLElement) || root.dataset.ready === "true") continue;

    const canvas = root.querySelector("canvas");
    const host = root.closest(".hero");
    if (
      !(canvas instanceof HTMLCanvasElement) ||
      !(host instanceof HTMLElement)
    ) {
      continue;
    }

    const context = canvas.getContext("2d", { alpha: true });
    if (!context) continue;

    root.dataset.ready = "true";

    let width = 0;
    let height = 0;
    let pixelRatio = 1;
    let radius = 0;
    let frame = 0;
    let visible = true;
    let lastDraw = 0;
    let points: SpherePoint[] = [];
    const pointer = { x: 0, y: 0, active: false };
    const nodePositions = [0.04, 0.18, 0.37, 0.59, 0.81];
    const links: Array<readonly [number, number]> = [
      [0, 1],
      [0, 2],
      [1, 3],
      [2, 3],
      [2, 4],
      [3, 4],
    ];

    const buildPoints = () => {
      const count = width < 600 ? 420 : 720;
      const goldenAngle = Math.PI * (3 - Math.sqrt(5));
      points = Array.from({ length: count }, (_, index) => {
        const y = 1 - (index / (count - 1)) * 2;
        const ring = Math.sqrt(Math.max(0, 1 - y * y));
        const angle = goldenAngle * index;
        return {
          x: Math.cos(angle) * ring,
          y,
          z: Math.sin(angle) * ring,
          size: index % 17 === 0 ? 1.8 : index % 5 === 0 ? 1.25 : 0.85,
          phase: (index * 0.61803398875) % 1,
        };
      });
    };

    const project = (
      point: SpherePoint,
      rotationY: number,
      rotationX: number,
    ): ProjectedPoint => {
      const cosY = Math.cos(rotationY);
      const sinY = Math.sin(rotationY);
      const xzX = point.x * cosY - point.z * sinY;
      const xzZ = point.x * sinY + point.z * cosY;
      const cosX = Math.cos(rotationX);
      const sinX = Math.sin(rotationX);
      const yzY = point.y * cosX - xzZ * sinX;
      const yzZ = point.y * sinX + xzZ * cosX;
      const perspective = 1.75 / (2.25 - yzZ * 0.34);
      return {
        x: width / 2 + xzX * radius * perspective,
        y: height * 0.54 + yzY * radius * perspective,
        z: yzZ,
        scale: perspective,
      };
    };

    const draw = (time: number) => {
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      context.clearRect(0, 0, width, height);

      const elapsed = reduceMotion.matches ? 0 : time * 0.000075;
      const pointerY =
        pointer.active && !reduceMotion.matches ? pointer.x * 0.14 : 0;
      const pointerX =
        pointer.active && !reduceMotion.matches ? pointer.y * 0.09 : 0;
      const rotationY = 0.34 + elapsed + pointerY;
      const rotationX = -0.08 + pointerX;
      const projected = points.map((point) =>
        project(point, rotationY, rotationX),
      );

      context.save();
      context.globalCompositeOperation = "lighter";
      for (let index = 0; index < points.length; index += 1) {
        const point = points[index];
        const screen = projected[index];
        if (!point || !screen) continue;
        const depth = Math.max(0.08, (screen.z + 1) / 2);
        const shimmer = reduceMotion.matches
          ? 0
          : Math.sin(elapsed * 34 + point.phase * Math.PI * 2) * 0.08;
        const alpha = Math.max(
          0.08,
          Math.min(0.78, 0.12 + depth * 0.5 + shimmer),
        );
        const size = Math.max(
          0.8,
          point.size * screen.scale * (0.8 + depth * 0.6),
        );
        context.fillStyle = `rgba(132, 240, 205, ${alpha})`;
        context.beginPath();
        context.arc(screen.x, screen.y, size, 0, Math.PI * 2);
        context.fill();
      }

      const projectedNodes = nodePositions
        .map(
          (position) =>
            projected[Math.round((projected.length - 1) * position)],
        )
        .filter(Boolean);
      context.lineWidth = 1;
      context.setLineDash([2, 6]);
      for (const [fromIndex, toIndex] of links) {
        const from = projectedNodes[fromIndex];
        const to = projectedNodes[toIndex];
        if (!from || !to) continue;
        const depth = Math.max(0.14, ((from.z + to.z) / 2 + 1) / 2);
        context.strokeStyle = `rgba(161, 239, 215, ${0.12 + depth * 0.32})`;
        context.beginPath();
        context.moveTo(from.x, from.y);
        context.quadraticCurveTo(
          width / 2 + (from.x + to.x - width) * 0.24,
          height * 0.54 + (from.y + to.y - height * 1.08) * 0.24,
          to.x,
          to.y,
        );
        context.stroke();
      }
      context.setLineDash([]);

      projectedNodes.forEach((node, index) => {
        if (!node) return;
        const depth = Math.max(0.18, (node.z + 1) / 2);
        const pulse = reduceMotion.matches
          ? 0
          : (Math.sin(elapsed * 45 + index) + 1) * 1.2;
        context.strokeStyle = `rgba(202, 255, 238, ${0.3 + depth * 0.55})`;
        context.lineWidth = 1;
        context.beginPath();
        context.arc(node.x, node.y, 8 + pulse, 0, Math.PI * 2);
        context.stroke();
        context.fillStyle = "#d9fff2";
        context.beginPath();
        context.arc(node.x, node.y, 2.6 + depth * 1.4, 0, Math.PI * 2);
        context.fill();
      });
      context.restore();
    };

    const rebuild = () => {
      const bounds = root.getBoundingClientRect();
      width = Math.max(1, Math.round(bounds.width));
      height = Math.max(1, Math.round(bounds.height));
      radius = Math.min(width * 0.42, height * 0.47, 390);
      pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      buildPoints();
      draw(0);
    };

    const animate = (time: number) => {
      if (
        !reduceMotion.matches &&
        interactivePointer.matches &&
        visible &&
        document.visibilityState === "visible"
      ) {
        if (time - lastDraw > 32) {
          draw(time);
          lastDraw = time;
        }
        frame = window.requestAnimationFrame(animate);
      }
    };

    const restartAnimation = () => {
      window.cancelAnimationFrame(frame);
      if (
        reduceMotion.matches ||
        !interactivePointer.matches ||
        !visible ||
        document.visibilityState !== "visible"
      ) {
        draw(0);
        return;
      }
      frame = window.requestAnimationFrame(animate);
    };

    const updatePointer = (event: PointerEvent) => {
      if (
        reduceMotion.matches ||
        !interactivePointer.matches ||
        (event.pointerType !== "mouse" && event.pointerType !== "pen")
      ) {
        return;
      }
      const bounds = root.getBoundingClientRect();
      pointer.x = (event.clientX - bounds.left) / width - 0.5;
      pointer.y = (event.clientY - bounds.top) / height - 0.5;
      pointer.active = true;
    };

    const clearPointer = () => {
      pointer.active = false;
    };

    const resizeObserver = new ResizeObserver(rebuild);
    const intersectionObserver = new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? true;
      restartAnimation();
    });

    resizeObserver.observe(root);
    intersectionObserver.observe(root);
    host.addEventListener("pointermove", updatePointer, { passive: true });
    host.addEventListener("pointerleave", clearPointer, { passive: true });
    reduceMotion.addEventListener("change", restartAnimation);
    interactivePointer.addEventListener("change", restartAnimation);
    document.addEventListener("visibilitychange", restartAnimation);
    rebuild();
    restartAnimation();
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(48rem, 86vh, 57rem);
    align-items: center;
    overflow: hidden;
    padding-block: clamp(5.5rem, 11vw, 8rem);
    border-bottom: 1px solid var(--border-subtle);
    background: #07110f;
  }

  .hero::after {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 9rem;
    background: linear-gradient(transparent, rgb(7 17 15 / 82%));
    content: "";
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 4;
  }

  .hero :global(.hero__copy) {
    position: relative;
    width: min(100%, 54rem);
    margin-inline: auto;
    text-align: center;
  }

  .hero :global(h1) {
    max-width: 11.5ch;
    margin-inline: auto;
    margin-bottom: 1.8rem;
    color: #f5fff9;
    font-size: clamp(3.5rem, 7vw, 6.2rem);
    text-wrap: balance;
  }

  .hero :global(h1 em) {
    display: block;
    color: #84f0cd;
    font-family: var(--font-editorial);
    font-size: 1.04em;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .hero :global(.hero__actions) {
    justify-content: center;
    margin-top: 2.25rem;
  }

  .hero :global(.eyebrow) {
    justify-content: center;
    color: #84f0cd;
  }

  .hero :global(.eyebrow)::before {
    background: #d9fff2;
    box-shadow: 0 0 1.2rem rgb(132 240 205 / 72%);
  }

  .hero :global(.lede) {
    max-width: 43rem;
    margin-inline: auto;
    color: #c5d9d2;
  }

  .hero :global(.button) {
    background: #84f0cd;
    color: #07110f;
  }

  .hero :global(.button:hover) {
    background: #a9f6de;
    box-shadow: 4px 4px 0 rgb(0 0 0 / 28%);
  }

  .hero :global(.button--secondary) {
    border-color: rgb(197 217 210 / 48%);
    background: rgb(7 17 15 / 48%);
    color: #f5fff9;
    backdrop-filter: blur(10px);
  }

  .hero :global(.button--secondary:hover) {
    border-color: #d9fff2;
    background: rgb(132 240 205 / 12%);
  }

  .hero :global(.button--quiet) {
    background: transparent;
    color: #c5d9d2;
    text-decoration-color: rgb(197 217 210 / 48%);
  }

  .hero :global(.button--quiet:hover) {
    background: transparent;
    color: #f5fff9;
  }

  .hero :global(.hero__note) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    align-items: center;
    margin-top: 2rem;
    margin-bottom: 0;
    color: #9eb8af;
    font-size: 0.8rem;
  }

  .hero :global(.status) {
    border-color: rgb(197 217 210 / 28%);
    background: rgb(7 17 15 / 52%);
    color: #d9fff2;
    backdrop-filter: blur(10px);
  }

  .signal-sphere {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 55%, rgb(55 191 151 / 13%), transparent 34%),
      radial-gradient(
        circle at 50% 55%,
        transparent 0 39%,
        rgb(6 22 19 / 66%) 64%
      ),
      #07110f;
    isolation: isolate;
  }

  .signal-sphere::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgb(130 216 190 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(130 216 190 / 3%) 1px, transparent 1px);
    background-size: 34px 34px;
    content: "";
    mask-image: radial-gradient(circle at 50% 55%, #000, transparent 68%);
  }

  .signal-sphere::after {
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      linear-gradient(
        180deg,
        rgb(7 17 15 / 78%) 0%,
        transparent 34%,
        transparent 72%,
        rgb(7 17 15 / 82%) 100%
      ),
      radial-gradient(
        ellipse at 50% 32%,
        rgb(7 17 15 / 44%) 0%,
        transparent 52%
      );
    content: "";
    pointer-events: none;
  }

  canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  .signal-sphere__halo {
    position: absolute;
    top: 54%;
    left: 50%;
    z-index: 0;
    width: min(72vw, 47rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border: 1px solid rgb(132 240 205 / 18%);
    border-radius: 50%;
    box-shadow:
      inset 0 0 7rem rgb(66 218 170 / 9%),
      0 0 7rem rgb(66 218 170 / 7%);
  }

  .signal-sphere__activity {
    position: absolute;
    inset: 0;
    z-index: 2;
    font-family: var(--font-mono);
  }

  .signal-sphere__message {
    position: absolute;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem 0.55rem;
    min-width: 10rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid rgb(169 238 217 / 18%);
    border-radius: var(--radius-sm);
    background: rgb(7 28 23 / 56%);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 18%);
    color: #d9fff2;
    opacity: 0.64;
    backdrop-filter: blur(10px);
  }

  .signal-sphere__message i {
    grid-row: 1 / span 2;
    width: 0.42rem;
    height: 0.42rem;
    margin-top: 0.18rem;
    border-radius: 50%;
    background: #84f0cd;
    box-shadow: 0 0 0 0.25rem rgb(132 240 205 / 11%);
  }

  .signal-sphere__message b {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .signal-sphere__message small {
    color: #83aa9d;
    font-size: 0.55rem;
    line-height: 1.35;
  }

  .signal-sphere__message--one {
    top: 28%;
    left: max(3vw, calc(50% - 31rem));
  }

  .signal-sphere__message--two {
    right: max(3vw, calc(50% - 30rem));
    bottom: 24%;
  }

  .signal-sphere__message--three {
    bottom: 14%;
    left: max(8vw, calc(50% - 22rem));
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 52rem;
      align-items: start;
      padding-block: 5rem 9rem;
    }

    .hero :global(h1) {
      font-size: clamp(3rem, 15vw, 4.75rem);
    }

    .signal-sphere {
      background:
        radial-gradient(
          circle at 50% 66%,
          rgb(55 191 151 / 15%),
          transparent 38%
        ),
        radial-gradient(
          circle at 50% 66%,
          transparent 0 36%,
          rgb(6 22 19 / 68%) 66%
        ),
        #07110f;
    }

    .signal-sphere__halo {
      top: 66%;
      width: 38rem;
    }

    .signal-sphere__message {
      transform: scale(0.84);
    }

    .signal-sphere__message--one {
      top: auto;
      bottom: 22%;
      left: -1rem;
    }

    .signal-sphere__message--two {
      right: -1rem;
      bottom: 9%;
    }

    .signal-sphere__message--three {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-sphere__message {
      backdrop-filter: none;
    }
  }
</style>
