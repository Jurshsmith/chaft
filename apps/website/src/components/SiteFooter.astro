---
import { Image } from "astro:assets";

import mark from "../../../desktop-qt/resources/branding/chaft-mark.png";
import { sitePath } from "../lib/site-path";

const year = new Date().getUTCFullYear();
const groups = [
  {
    label: "Product",
    links: [
      { href: sitePath("/download/"), label: "Download" },
      { href: sitePath("/releases/"), label: "Releases" },
      { href: sitePath("/security/"), label: "Security" },
    ],
  },
  {
    label: "Learn",
    links: [
      { href: sitePath("/docs/"), label: "Documentation" },
      { href: sitePath("/docs/getting-started/workspace-lifecycle/"), label: "Getting started" },
      { href: sitePath("/docs/concepts/architecture/"), label: "Architecture" },
    ],
  },
  {
    label: "Project",
    links: [
      { href: "https://github.com/Jurshsmith/chaft", label: "Source" },
      { href: "https://github.com/Jurshsmith/chaft/blob/main/CONTRIBUTING.md", label: "Contributing" },
      { href: "https://github.com/Jurshsmith/chaft/issues", label: "Issue tracker" },
    ],
  },
  {
    label: "Legal",
    links: [
      { href: "https://github.com/Jurshsmith/chaft/blob/main/LICENSE", label: "AGPL-3.0-or-later" },
      { href: "https://github.com/Jurshsmith/chaft/blob/main/SECURITY.md", label: "Security policy" },
      { href: sitePath("/licenses/OFL-SpaceGrotesk.txt"), label: "Font license" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div class="site-footer__lead">
      <a class="footer-brand" href={sitePath("/")} aria-label="Chaft home">
        <span class="footer-brand__mark" aria-hidden="true">
          <Image src={mark} alt="" width={40} height={40} format="webp" quality={90} loading="lazy" />
        </span>
        <span>chaft</span>
      </a>
      <p>Open-source desktop chat for small teams.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      {groups.map((group) => (
        <div class="footer-nav__group">
          <p>{group.label}</p>
          <ul>
            {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>

    <div class="site-footer__bottom">
      <p>© {year} Chaft.</p>
      <p class="site-footer__status"><span aria-hidden="true"></span> Canary · unsigned and unaudited</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --border-subtle: #34423e;
    --text-faint: #91a09a;
    --text-muted: #bdc8c4;
    --text-strong: #fffdf7;
    border-top: 1px solid var(--border-subtle);
    background: #17211f;
    color: var(--text-strong);
  }

  .site-footer__inner {
    padding-block: clamp(3rem, 6vw, 5rem) 1.5rem;
  }

  .site-footer__lead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border-subtle);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--text-strong);
    font-size: clamp(2.25rem, 5vw, 4.25rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1;
    text-decoration: none;
  }

  .footer-brand__mark {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
  }

  .footer-brand__mark :global(img) {
    width: 2.35rem;
    height: 2.35rem;
    object-fit: contain;
  }

  .site-footer__lead > p {
    max-width: 24rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    text-align: right;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .footer-nav__group > p {
    margin: 0 0 0.9rem;
    color: #71d8b9;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .footer-nav ul {
    display: grid;
    gap: 0.28rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-nav a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--text-strong);
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .site-footer__bottom p {
    margin: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .site-footer__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-footer__status span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--brand-coral);
  }

  .footer-brand:focus-visible,
  .footer-nav a:focus-visible {
    outline-color: #ff8a72;
  }

  @media (max-width: 720px) {
    .site-footer__lead {
      display: grid;
      gap: 1rem;
    }

    .site-footer__lead > p {
      text-align: left;
    }

    .footer-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }

    .footer-nav a {
      min-height: 2.75rem;
    }

    .site-footer__bottom {
      align-items: flex-start;
      flex-direction: column-reverse;
    }
  }
</style>
