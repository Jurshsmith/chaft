---
import { sitePath } from "../lib/site-path";

const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <a class="footer-brand" href={sitePath("/")}>chaft</a>
      <p>Open-source team chat that runs on your devices.</p>
    </div>

    <nav aria-label="Footer navigation">
      <a href={sitePath("/docs/")}>Documentation</a>
      <a href={sitePath("/docs/getting-started/build-desktop/")}>Getting started</a>
      <a href={sitePath("/docs/concepts/architecture/")}>Architecture</a>
      <a href={sitePath("/download/")}>Download</a>
      <a href={sitePath("/releases/")}>Releases</a>
      <a href={sitePath("/security/")}>Security</a>
      <a href="https://github.com/Jurshsmith/chaft/blob/main/CONTRIBUTING.md">
        Contributing
      </a>
      <a href="https://github.com/Jurshsmith/chaft">Source</a>
      <a href="https://github.com/Jurshsmith/chaft/blob/main/LICENSE">AGPL-3.0</a>
      <a href={sitePath("/licenses/OFL-SpaceGrotesk.txt")}>Font license</a>
    </nav>

    <p class="site-footer__meta">
      © {year} Chaft. Canary software · Not for sensitive production use.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    --border-subtle: #34423e;
    --text-faint: #91a09a;
    --text-muted: #b5c0bc;
    --text-soft: #dce4e0;
    --text-strong: #fffdf7;
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-ink);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(13rem, 1fr) auto;
    gap: 2rem 4rem;
    padding-block: 3.5rem;
  }

  .footer-brand {
    display: inline-block;
    margin-block-end: 0.35rem;
    color: var(--text-strong);
    font-family: var(--font-editorial);
    font-size: 1.55rem;
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  p {
    margin: 0;
    font-size: 0.88rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.4rem;
    justify-content: flex-end;
    align-content: start;
  }

  nav a {
    color: var(--text-muted);
    font-size: 0.88rem;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent-bright);
  }

  .site-footer__meta {
    grid-column: 1 / -1;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (max-width: 680px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>
