---
import { sitePath } from "../../lib/site-path";

const avatarSprite = sitePath("/assets/community-avatars.svg");

const contributors = [
  {
    assetId: "community-avatar-01",
    anchorX: 0.075,
    anchorY: 0.27,
    bendX: -18,
    bendY: 62,
    rotation: -4,
    scale: 0.94,
    opacity: 0.94,
    delay: 0,
  },
  {
    assetId: "community-avatar-02",
    anchorX: 0.245,
    anchorY: 0.56,
    bendX: -12,
    bendY: 20,
    rotation: 3,
    scale: 0.88,
    opacity: 0.92,
    delay: 0.035,
  },
  {
    assetId: "community-avatar-05",
    anchorX: 0.5,
    anchorY: 0.05,
    bendX: 0,
    bendY: 90,
    rotation: -2,
    scale: 0.64,
    opacity: 0.9,
    delay: 0.1,
    overlapTitle: true,
  },
  {
    assetId: "community-avatar-06",
    anchorX: 0.885,
    anchorY: 0.25,
    bendX: 47,
    bendY: 130,
    rotation: 3,
    scale: 0.98,
    opacity: 0.97,
    delay: 0,
  },
  {
    assetId: "community-avatar-07",
    anchorX: 0.94,
    anchorY: 0.49,
    bendX: 20,
    bendY: 14,
    rotation: -4,
    scale: 0.88,
    opacity: 0.92,
    delay: 0.065,
  },
  {
    assetId: "community-avatar-03",
    anchorX: 0.07,
    anchorY: 0.82,
    bendX: -16,
    bendY: 12,
    rotation: -3,
    scale: 0.98,
    opacity: 0.96,
    delay: 0.07,
  },
  {
    assetId: "community-avatar-04",
    anchorX: 0.285,
    anchorY: 0.88,
    bendX: -20,
    bendY: -8,
    rotation: 4,
    scale: 1.02,
    opacity: 0.98,
    delay: 0.045,
  },
  {
    assetId: "community-avatar-10",
    anchorX: 0.51,
    anchorY: 0.94,
    bendX: 0,
    bendY: -18,
    rotation: 2,
    scale: 0.96,
    opacity: 0.96,
    delay: 0.105,
  },
  {
    assetId: "community-avatar-09",
    anchorX: 0.79,
    anchorY: 0.91,
    bendX: 20,
    bendY: -12,
    rotation: -3,
    scale: 0.86,
    opacity: 0.92,
    delay: 0.125,
  },
  {
    assetId: "community-avatar-08",
    anchorX: 0.93,
    anchorY: 0.76,
    bendX: 18,
    bendY: 16,
    rotation: 3,
    scale: 0.92,
    opacity: 0.95,
    delay: 0.09,
  },
];
---

<section
  class="community-story"
  id="community"
  aria-labelledby="community-story-title"
  data-community-story
  data-community-motion="static"
>
  <div class="community-story__sticky">
    <div class="community-story__content">
      <header class="community-story__heading">
        <h2 id="community-story-title">
          <span>Built for the community.</span>
          <span>Strengthened by every contribution.</span>
        </h2>
        <p class="community-story__summary">
          Independent contributors come together around one open, shared workspace.
        </p>
      </header>

      <div class="community-story__stage" data-community-stage aria-hidden="true">
        <div class="community-story__grid" data-community-grid>
          {contributors.map((contributor, index) => (
            <span
              class="community-avatar__slot"
              data-community-slot
              data-anchor-x={contributor.anchorX}
              data-anchor-y={contributor.anchorY}
              data-title-overlap={contributor.overlapTitle ? "true" : undefined}
            >
              <span
                class="community-avatar"
                data-community-avatar
                data-profile={index + 1}
                data-bend-x={contributor.bendX}
                data-bend-y={contributor.bendY}
                data-scatter-rotation={contributor.rotation}
                data-scatter-scale={contributor.scale}
                data-scatter-opacity={contributor.opacity}
                data-scatter-delay={contributor.delay}
              >
                <span class="community-avatar__portrait">
                  <svg
                    class="community-avatar__art"
                    viewBox="0 0 1 1"
                    preserveAspectRatio="xMidYMid meet"
                    focusable="false"
                    aria-hidden="true"
                  >
                    <use
                      href={avatarSprite + "#" + contributor.assetId}
                      x="0"
                      y="0"
                      width="1"
                      height="1"
                    />
                  </svg>
                </span>
              </span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const clampCommunityProgress = (value: number) => Math.min(Math.max(value, 0), 1);
  const smootherCommunityProgress = (value: number) => (
    value * value * value * (value * (value * 6 - 15) + 10)
  );

  document.querySelectorAll<HTMLElement>("[data-community-story]").forEach((section) => {
    if (section.hasAttribute("data-community-initialized")) return;
    section.setAttribute("data-community-initialized", "");

    const stage = section.querySelector<HTMLElement>("[data-community-stage]");
    if (!stage) return;

    const avatars = Array.from(
      section.querySelectorAll<HTMLElement>("[data-community-avatar]"),
    ).map((avatar) => {
      const slot = avatar.closest<HTMLElement>("[data-community-slot]");
      return {
        avatar,
        slot,
        anchorX: Number(slot?.dataset.anchorX ?? 0.5),
        anchorY: Number(slot?.dataset.anchorY ?? 0.5),
        bendX: Number(avatar.dataset.bendX ?? 0),
        bendY: Number(avatar.dataset.bendY ?? 0),
        rotation: Number(avatar.dataset.scatterRotation ?? 0),
        scale: Number(avatar.dataset.scatterScale ?? 1),
        opacity: Number(avatar.dataset.scatterOpacity ?? 1),
        delay: Number(avatar.dataset.scatterDelay ?? 0),
        offsetX: 0,
        offsetY: 0,
      };
    });

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const compactViewport = window.matchMedia("(max-width: 1279px)");
    const shortViewport = window.matchMedia("(max-height: 767px)");

    let animationFrame = 0;
    let isActive = false;
    let isScrollDriven = false;
    let shouldMeasure = true;
    let lastProgress = "";

    const resetAvatars = () => {
      avatars.forEach(({ avatar }) => {
        avatar.style.removeProperty("--community-transform");
        avatar.style.removeProperty("--community-opacity");
      });
      lastProgress = "";
    };

    const readProgress = () => {
      const rect = section.getBoundingClientRect();
      const scrollRange = Math.max(section.offsetHeight - window.innerHeight, 1);
      return clampCommunityProgress(-rect.top / scrollRange);
    };

    const measureAvatars = () => {
      const stageRect = stage.getBoundingClientRect();

      avatars.forEach((motion) => {
        if (!motion.slot) return;

        const slotRect = motion.slot.getBoundingClientRect();
        const radius = Math.max(slotRect.width, slotRect.height) / 2
          * Math.max(motion.scale, 1);
        const safeInset = radius + 10;
        const anchorX = Math.min(
          Math.max(stageRect.width * motion.anchorX, safeInset),
          stageRect.width - safeInset,
        );
        const anchorY = Math.min(
          Math.max(stageRect.height * motion.anchorY, safeInset),
          stageRect.height - safeInset,
        );
        const finalCenterX = slotRect.left - stageRect.left + slotRect.width / 2;
        const finalCenterY = slotRect.top - stageRect.top + slotRect.height / 2;

        motion.offsetX = anchorX - finalCenterX;
        motion.offsetY = anchorY - finalCenterY;
      });

      shouldMeasure = false;
    };

    const render = (progress: number) => {
      const gatheringProgress = clampCommunityProgress((progress - 0.055) / 0.865);

      avatars.forEach((motion) => {
        const localProgress = clampCommunityProgress(
          (gatheringProgress - motion.delay) / Math.max(1 - motion.delay, 0.01),
        );
        const easedProgress = smootherCommunityProgress(localProgress);
        const remaining = 1 - easedProgress;
        const curve = 4 * easedProgress * remaining;
        const x = motion.offsetX * remaining + motion.bendX * curve;
        const y = motion.offsetY * remaining + motion.bendY * curve;
        const rotation = motion.rotation * remaining;
        const scale = motion.scale
          + (1 - motion.scale) * easedProgress
          + Math.sin(Math.PI * easedProgress) * 0.018;
        const opacity = motion.opacity + (1 - motion.opacity) * easedProgress;
        const normalizedX = Math.abs(x) < 0.005 ? 0 : x;
        const normalizedY = Math.abs(y) < 0.005 ? 0 : y;
        const normalizedRotation = Math.abs(rotation) < 0.005 ? 0 : rotation;

        motion.avatar.style.setProperty(
          "--community-transform",
          "translate3d("
            + normalizedX.toFixed(2)
            + "px, "
            + normalizedY.toFixed(2)
            + "px, 0) rotate("
            + normalizedRotation.toFixed(2)
            + "deg) scale("
            + scale.toFixed(4)
            + ")",
        );
        motion.avatar.style.setProperty(
          "--community-opacity",
          opacity.toFixed(4),
        );
      });

      const nextProgress = progress.toFixed(3);
      if (nextProgress !== lastProgress) {
        section.dataset.communityProgress = nextProgress;
        lastProgress = nextProgress;
      }
    };

    const update = () => {
      animationFrame = 0;
      if (!isScrollDriven) return;
      if (shouldMeasure) measureAvatars();
      render(readProgress());
    };

    const scheduleUpdate = (force = false, measure = false) => {
      shouldMeasure ||= measure;
      if (!isScrollDriven || animationFrame || (!isActive && !force)) return;
      animationFrame = window.requestAnimationFrame(update);
    };

    const configureMotion = () => {
      const nextScrollDriven = !reducedMotion.matches
        && !compactViewport.matches
        && !shortViewport.matches
        && CSS.supports("position", "sticky");

      if (!nextScrollDriven) {
        isScrollDriven = false;
        if (animationFrame) {
          window.cancelAnimationFrame(animationFrame);
          animationFrame = 0;
        }
        section.removeAttribute("data-community-ready");
        section.removeAttribute("data-community-layout");
        section.dataset.communityMotion = reducedMotion.matches ? "reduced" : "simplified";
        section.dataset.communityProgress = "1.000";
        resetAvatars();
        return;
      }

      isScrollDriven = true;
      section.dataset.communityMotion = "scroll";
      section.setAttribute("data-community-layout", "");
      shouldMeasure = true;
      measureAvatars();
      render(readProgress());
      section.setAttribute("data-community-ready", "");
      scheduleUpdate(true);
    };

    window.addEventListener("scroll", () => scheduleUpdate(), { passive: true });
    window.addEventListener(
      "resize",
      () => scheduleUpdate(true, true),
      { passive: true },
    );
    reducedMotion.addEventListener("change", configureMotion);
    compactViewport.addEventListener("change", configureMotion);
    shortViewport.addEventListener("change", configureMotion);

    new ResizeObserver(() => scheduleUpdate(true, true)).observe(stage);
    new IntersectionObserver(
      ([entry]) => {
        isActive = Boolean(entry?.isIntersecting);
        section.toggleAttribute("data-community-active", isActive);
        if (isActive) scheduleUpdate(true);
      },
      { rootMargin: "30% 0px" },
    ).observe(section);

    configureMotion();
  });
</script>

<style>
  .community-story {
    position: relative;
    isolation: isolate;
    border-block: 1px solid var(--border-subtle);
    background:
      radial-gradient(circle at 50% 44%, rgb(75 195 162 / 10%), transparent 31rem),
      linear-gradient(180deg, rgb(255 253 248 / 68%), transparent 44%),
      var(--surface-raised);
    scroll-margin-top: 5.5rem;
  }

  .community-story__sticky {
    display: grid;
    min-height: 100svh;
    align-items: center;
    padding-block: clamp(6rem, 12svh, 8rem) clamp(4.5rem, 9svh, 6rem);
  }

  .community-story__content {
    display: grid;
    width: 100%;
    gap: clamp(3rem, 8svh, 5.5rem);
    align-content: center;
  }

  .community-story__heading {
    position: relative;
    z-index: 3;
    display: grid;
    box-sizing: border-box;
    width: min(100%, 84rem);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
    justify-items: center;
    text-align: center;
  }

  .community-story__heading h2 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(2.5rem, 6.15vw, 5.8rem);
    line-height: 0.98;
    letter-spacing: -0.052em;
    text-wrap: balance;
  }

  .community-story__heading h2 span {
    display: block;
  }

  .community-story__summary {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .community-story__stage {
    position: relative;
    display: grid;
    min-height: 15rem;
    place-items: center;
    pointer-events: none;
  }

  .community-story__grid {
    display: grid;
    grid-template-columns: repeat(5, auto);
    gap: clamp(1rem, 2.2vw, 2rem) clamp(0.75rem, 1.8vw, 1.6rem);
    align-items: center;
    justify-content: center;
  }

  .community-avatar__slot {
    position: relative;
    display: block;
    width: clamp(4.1rem, 6.25vw, 5.75rem);
    aspect-ratio: 1;
  }

  .community-avatar {
    --community-opacity: 1;
    --community-transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
    position: absolute;
    inset: 0;
    display: block;
    transform-origin: center;
  }

  .community-story[data-community-ready] .community-avatar {
    transform: var(--community-transform);
    opacity: var(--community-opacity);
  }

  .community-avatar__portrait {
    --avatar-background: #e9eee8;
    position: absolute;
    inset: 0;
    display: grid;
    overflow: hidden;
    border: 1px solid rgb(23 33 31 / 20%);
    border-radius: 50%;
    place-items: end center;
    background:
      radial-gradient(circle at 32% 22%, rgb(255 255 255 / 92%), transparent 43%),
      var(--avatar-background);
    box-shadow:
      0 0.85rem 2rem rgb(23 33 31 / 12%),
      inset 0 0 0 0.2rem rgb(255 255 255 / 42%);
  }

  .community-avatar__portrait::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 -0.5rem 1.2rem rgb(23 33 31 / 5%);
    content: "";
  }

  .community-avatar__art {
    width: 94%;
    height: 94%;
    transform: translateY(4%);
    overflow: visible;
  }

  .community-avatar__slot:nth-child(2) .community-avatar__portrait {
    --avatar-background: #ece8dc;
  }

  .community-avatar__slot:nth-child(3) .community-avatar__portrait {
    --avatar-background: #e4edf0;
  }

  .community-avatar__slot:nth-child(4) .community-avatar__portrait {
    --avatar-background: #eee5e0;
  }

  .community-avatar__slot:nth-child(5) .community-avatar__portrait {
    --avatar-background: #e5ede2;
  }

  .community-avatar__slot:nth-child(6) .community-avatar__portrait {
    --avatar-background: #e8e6ef;
  }

  .community-avatar__slot:nth-child(7) .community-avatar__portrait {
    --avatar-background: #eee9d9;
  }

  .community-avatar__slot:nth-child(8) .community-avatar__portrait {
    --avatar-background: #e2ece9;
  }

  .community-avatar__slot:nth-child(9) .community-avatar__portrait {
    --avatar-background: #efe3df;
  }

  .community-avatar__slot:nth-child(10) .community-avatar__portrait {
    --avatar-background: #e5e9ef;
  }

  .community-story[data-community-layout] {
    min-height: 245svh;
  }

  .community-story[data-community-layout] .community-story__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    overflow: clip;
    padding: 0;
  }

  .community-story[data-community-layout] .community-story__content {
    position: relative;
    display: block;
    height: 100%;
  }

  .community-story[data-community-layout] .community-story__heading {
    position: absolute;
    top: 36%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .community-story[data-community-layout] .community-story__stage {
    position: absolute;
    inset: 5rem 0 0;
    z-index: 1;
    display: block;
    min-height: 0;
  }

  .community-story[data-community-layout] .community-story__grid {
    position: absolute;
    top: 59%;
    left: 50%;
    transform: translateX(-50%);
  }

  .community-story[data-community-ready][data-community-active] .community-avatar {
    will-change: transform, opacity;
  }

  @media (max-width: 1279px), (max-height: 767px) {
    .community-story__sticky {
      min-height: auto;
      padding-block: clamp(5rem, 16vw, 7rem);
    }

    .community-story__content {
      display: grid;
      height: auto;
      gap: clamp(3rem, 12vw, 5rem);
    }

    .community-story__heading {
      position: relative;
      top: auto;
      left: auto;
      width: min(100%, 84rem);
      transform: none;
    }

    .community-story__heading h2 {
      max-width: 17ch;
      font-size: clamp(2rem, 9vw, 3.2rem);
      line-height: 1.02;
    }

    .community-story__stage {
      position: relative;
      inset: auto;
      min-height: auto;
    }

    .community-story__grid {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      gap: clamp(0.85rem, 4vw, 1.35rem) clamp(0.45rem, 2.2vw, 0.9rem);
    }

    .community-avatar__slot {
      width: clamp(2.9rem, 14vw, 4.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .community-avatar {
      transform: none !important;
      opacity: 1 !important;
    }
  }

  @media (forced-colors: active) {
    .community-avatar__portrait {
      border: 2px solid CanvasText;
      box-shadow: none;
    }
  }
</style>
