---
import { Image } from "astro:assets";

import desktopCanary from "../../assets/desktop-canary-linux.png";
---

<section
  class="product-reveal"
  aria-labelledby="product-reveal-title"
  data-product-reveal
  data-reveal-motion="static"
>
  <div class="product-reveal__sticky" data-reveal-sticky>
    <div class="shell product-reveal__copy">
      <div>
        <p class="eyebrow">Chaft Desktop</p>
        <h2 id="product-reveal-title">A working canary, not a concept mockup.</h2>
      </div>
      <p class="body-copy">
        This native Linux capture comes from Chaft's deterministic desktop smoke
        test. It shows the current room list, messages, replies, attachments, access
        controls, and synchronization state.
      </p>
    </div>

    <figure class="product-reveal__stage">
      <div class="laptop" data-reveal-laptop>
        <div class="laptop__lid">
          <span class="laptop__camera" aria-hidden="true"></span>
          <div class="laptop__screen">
            <Image
              src={desktopCanary}
              alt="Chaft Desktop showing a test workspace with rooms, messages, reply context, an attachment, access controls, and synchronization status"
              widths={[720, 1080, 1440]}
              sizes="(max-width: 600px) 96vw, min(92vw, 1320px)"
              format="webp"
              quality={90}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <div class="laptop__base" aria-hidden="true"></div>
        <div class="laptop__shadow" aria-hidden="true"></div>
      </div>

      <figcaption>
        Native Linux canary · Deterministic test data generated by the desktop CI smoke test
      </figcaption>
    </figure>
  </div>
</section>

<script>
  const clamp = (value: number) => Math.min(Math.max(value, 0), 1);
  const smoothstep = (value: number) => value * value * (3 - 2 * value);

  document.querySelectorAll<HTMLElement>("[data-product-reveal]").forEach((section) => {
    const laptop = section.querySelector<HTMLElement>("[data-reveal-laptop]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!laptop) return;

    let animationFrame = 0;

    const update = () => {
      animationFrame = 0;

      if (reducedMotion.matches) return;

      const rect = section.getBoundingClientRect();
      const scrollRange = Math.max(section.offsetHeight - window.innerHeight, 1);
      const progress = clamp(-rect.top / scrollRange);
      const easedProgress = smoothstep(progress);
      const compactViewport = window.innerWidth <= 600;
      const initialScale = compactViewport ? 0.7 : 0.44;
      const scale = initialScale + (1 - initialScale) * easedProgress;
      const initialLift = compactViewport ? 3.5 : 6.5;
      const finalLift = compactViewport ? -0.75 : -1.5;
      const lift = initialLift + (finalLift - initialLift) * easedProgress;
      const copyOpacity = clamp(1 - progress * 2.7);
      const copyLift = -1.5 * (1 - copyOpacity);
      const captionOpacity = clamp(0.75 - progress * 0.9);

      laptop.style.setProperty("--reveal-scale", scale.toFixed(4));
      laptop.style.setProperty("--reveal-lift", `${lift.toFixed(3)}svh`);
      section.style.setProperty("--reveal-copy-opacity", copyOpacity.toFixed(4));
      section.style.setProperty("--reveal-copy-lift", `${copyLift.toFixed(3)}rem`);
      section.style.setProperty("--reveal-caption-opacity", captionOpacity.toFixed(4));
      section.dataset.revealProgress = progress.toFixed(3);
    };

    const scheduleUpdate = () => {
      if (animationFrame) return;
      animationFrame = window.requestAnimationFrame(update);
    };

    const configureMotion = () => {
      if (reducedMotion.matches) {
        section.removeAttribute("data-reveal-ready");
        section.dataset.revealMotion = "reduced";
        section.dataset.revealProgress = "1.000";
        laptop.style.removeProperty("--reveal-scale");
        laptop.style.removeProperty("--reveal-lift");
        section.style.removeProperty("--reveal-copy-opacity");
        section.style.removeProperty("--reveal-copy-lift");
        section.style.removeProperty("--reveal-caption-opacity");
        return;
      }

      section.setAttribute("data-reveal-ready", "");
      section.dataset.revealMotion = "scroll";
      scheduleUpdate();
    };

    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate, { passive: true });
    reducedMotion.addEventListener("change", configureMotion);
    new ResizeObserver(scheduleUpdate).observe(section);
    new IntersectionObserver(
      ([entry]) => section.toggleAttribute("data-reveal-active", Boolean(entry?.isIntersecting)),
      { rootMargin: "35% 0px" },
    ).observe(section);
    configureMotion();
  });
</script>

<style>
  .product-reveal {
    --reveal-caption-opacity: 1;
    --reveal-copy-lift: 0rem;
    --reveal-copy-opacity: 1;
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid var(--border-subtle);
    background:
      radial-gradient(circle at 50% 48%, rgb(7 112 84 / 7%), transparent 36rem),
      var(--surface-raised);
  }

  .product-reveal__sticky {
    position: relative;
    display: grid;
    min-height: 100svh;
    align-content: center;
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .product-reveal__copy {
    display: grid;
    z-index: 2;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    width: 100%;
    max-width: 100vw;
    margin-block-end: clamp(2.5rem, 6vw, 4.5rem);
    opacity: var(--reveal-copy-opacity);
  }

  .product-reveal__copy h2,
  .product-reveal__copy p {
    margin-block-end: 0;
  }

  .product-reveal__copy .body-copy {
    max-width: 34rem;
    font-size: 1.08rem;
  }

  .product-reveal__stage {
    position: relative;
    display: grid;
    width: 100%;
    max-width: 100vw;
    min-height: min(68svh, 48rem);
    place-items: center;
    margin: 0;
    overflow: clip;
    padding: 0 var(--page-gutter) 2.6rem;
  }

  .laptop {
    --reveal-lift: 0svh;
    --reveal-scale: 1;
    position: relative;
    width: min(85vw, 132.44svh, 76.5rem);
    transform: translate3d(0, var(--reveal-lift), 0) scale(var(--reveal-scale));
    transform-origin: center;
  }

  .laptop__lid {
    position: relative;
    z-index: 2;
    padding: clamp(0.38rem, 0.82vw, 0.72rem);
    border: 1px solid #45514d;
    border-radius: clamp(0.6rem, 1.3vw, 1.05rem) clamp(0.6rem, 1.3vw, 1.05rem) 0.38rem 0.38rem;
    background: linear-gradient(145deg, #2f3835, #111715 58%, #28312e);
    box-shadow:
      0 2.2rem 4.8rem rgb(23 33 31 / 20%),
      inset 0 1px 0 rgb(255 255 255 / 14%);
  }

  .laptop__camera {
    position: absolute;
    top: max(0.18rem, 0.27vw);
    left: 50%;
    z-index: 4;
    width: clamp(0.18rem, 0.3vw, 0.3rem);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #71817c;
    box-shadow: 0 0 0 1px #0d1211;
  }

  .laptop__screen {
    position: relative;
    overflow: hidden;
    aspect-ratio: 72 / 41;
    border: 1px solid #0d1211;
    border-radius: clamp(0.2rem, 0.42vw, 0.38rem);
    background: #101917;
  }

  .laptop__screen::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, rgb(255 255 255 / 5%), transparent 24% 76%, rgb(75 195 162 / 3%));
    pointer-events: none;
    content: "";
  }

  .laptop__screen :global(picture),
  .laptop__screen :global(img) {
    width: 100%;
    height: 100%;
  }

  .laptop__screen :global(img) {
    object-fit: cover;
  }

  .laptop__base {
    position: relative;
    z-index: 3;
    width: 108%;
    height: clamp(0.52rem, 1.25vw, 1.1rem);
    margin-left: -4%;
    border-top: 1px solid #aab1ae;
    border-radius: 0 0 48% 48% / 0 0 75% 75%;
    background: linear-gradient(180deg, #e2e4e1, #858e8a 50%, #525c58 78%, #2a322f);
    clip-path: polygon(3.5% 0, 96.5% 0, 100% 68%, 97.6% 100%, 2.4% 100%, 0 68%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 72%),
      0 0.6rem 1rem rgb(23 33 31 / 18%);
  }

  .laptop__base::after {
    position: absolute;
    top: 0;
    left: 50%;
    width: 13%;
    height: 32%;
    transform: translateX(-50%);
    border-radius: 0 0 0.45rem 0.45rem;
    background: #707a76;
    content: "";
  }

  .laptop__shadow {
    position: absolute;
    right: 5%;
    bottom: -4.8%;
    left: 5%;
    z-index: 1;
    height: 8%;
    transform: translateZ(0);
    border-radius: 50%;
    background: rgb(23 33 31 / 22%);
    filter: blur(clamp(0.55rem, 1.5vw, 1.2rem));
  }

  .product-reveal__stage figcaption {
    max-width: calc(100% - var(--page-gutter) - var(--page-gutter));
    margin-top: 1.35rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.45;
    text-align: center;
  }

  .product-reveal[data-reveal-ready] {
    min-height: 215svh;
  }

  .product-reveal[data-reveal-ready] .product-reveal__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    padding: 0;
    overflow: clip;
  }

  .product-reveal[data-reveal-ready] .product-reveal__copy {
    position: absolute;
    top: clamp(6rem, 11svh, 7rem);
    left: 50%;
    transform: translate3d(-50%, var(--reveal-copy-lift), 0);
    pointer-events: none;
  }

  .product-reveal[data-reveal-ready] .product-reveal__stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    height: auto;
    min-height: 0;
    padding-bottom: 0;
  }

  .product-reveal[data-reveal-ready][data-reveal-active] .laptop {
    will-change: transform;
  }

  .product-reveal[data-reveal-ready] .product-reveal__stage figcaption {
    position: absolute;
    right: var(--page-gutter);
    bottom: clamp(0.8rem, 2svh, 1.35rem);
    left: var(--page-gutter);
    margin: 0;
    opacity: var(--reveal-caption-opacity);
  }

  @media (max-width: 760px) {
    .product-reveal__copy {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      align-items: start;
    }

    .product-reveal__copy h2 {
      max-width: 15ch;
      font-size: clamp(1.85rem, 8.2vw, 2.75rem);
    }

    .product-reveal__copy .body-copy {
      max-width: 38rem;
      font-size: 0.95rem;
      line-height: 1.5;
    }
  }

  @media (max-width: 600px) {
    .product-reveal[data-reveal-ready] {
      min-height: 170svh;
    }

    .product-reveal[data-reveal-ready] .product-reveal__copy {
      top: 5.5rem;
    }

    .product-reveal[data-reveal-ready] .product-reveal__copy .eyebrow {
      margin-block-end: 0.65rem;
      font-size: 0.68rem;
    }

    .product-reveal[data-reveal-ready] .product-reveal__copy .body-copy {
      display: none;
    }

    .laptop {
      width: 88vw;
    }

    .product-reveal[data-reveal-ready] .product-reveal__stage figcaption {
      right: 1rem;
      bottom: 0.7rem;
      left: 1rem;
      max-width: none;
      font-size: 0.58rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-reveal,
    .product-reveal[data-reveal-ready] {
      min-height: auto;
    }

    .product-reveal[data-reveal-ready] .product-reveal__sticky {
      position: relative;
      height: auto;
      min-height: 100svh;
      padding-block: clamp(4rem, 9vw, 7rem);
      overflow: visible;
    }

    .product-reveal[data-reveal-ready] .product-reveal__copy {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }

    .product-reveal[data-reveal-ready] .product-reveal__stage {
      height: auto;
      min-height: min(68svh, 48rem);
      padding-bottom: 2.6rem;
    }

    .product-reveal[data-reveal-ready] .laptop,
    .laptop {
      transform: none;
      will-change: auto;
    }

    .product-reveal[data-reveal-ready] .product-reveal__stage figcaption {
      position: relative;
      inset: auto;
      margin-top: 1.35rem;
      opacity: 1;
    }
  }
</style>
