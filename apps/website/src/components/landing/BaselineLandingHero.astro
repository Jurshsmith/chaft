---
import ProductConstellationLandingHero from "./ProductConstellationLandingHero.astro";
import { sitePath } from "../../lib/site-path";

interface Props {
  hasPublishedDownloads: boolean;
}

const { hasPublishedDownloads } = Astro.props;
---

<ProductConstellationLandingHero {hasPublishedDownloads} heroId="baseline">
  <div class="hero__copy" slot="copy">
    <p class="eyebrow">Open-source desktop chat</p>
    <h1>Team chat without a <em>required central server.</em></h1>
    <p class="lede">
      Chaft keeps rooms, replies, files, search, and workspace history on each
      teammate's device. New activity syncs when authorized devices connect—without
      a required hosted workspace.
    </p>
    <div class="button-row hero__actions">
      <a class="button" href={sitePath("/download/")}>
        {hasPublishedDownloads ? "Download the early build" : "View the early build"}
        <span aria-hidden="true">→</span>
      </a>
      <a class="button button--secondary" href="#how-it-works">See how it works</a>
    </div>
    <p class="hero__note body-copy">
      Current preview · Windows, macOS, and Linux
    </p>
  </div>
</ProductConstellationLandingHero>
