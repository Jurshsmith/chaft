---
import { Image } from "astro:assets";

import securityBoundaryIllustration from "../../assets/security-boundary-illustration.jpg";
import { sitePath } from "../../lib/site-path";
---

<section
  class="security-overview section--deep"
  id="security-page-hero"
  aria-labelledby="security-page-title"
  data-security-page-hero
  data-security-motion="static"
>
  <div class="shell security-overview__grid">
    <div class="security-overview__copy" data-security-copy>
      <p class="eyebrow">Security status · Unaudited canary</p>
      <h1 id="security-page-title">Encrypted content. Signed, verifiable history.</h1>
      <p class="body-copy security-overview__lede">
        Chaft encrypts message and attachment content before replication, verifies
        signed history, and treats peers and optional replicas as untrusted.
      </p>

      <div class="security-overview__boundary" data-security-boundary>
        <span>Current boundary</span>
        <p>
          No central server is authoritative for workspace history. Metadata is not
          fully hidden.
        </p>
      </div>

      <div class="security-overview__actions">
        <a
          class="button"
          href="https://github.com/Jurshsmith/chaft/security/advisories/new"
        >
          Report privately
        </a>
        <a
          class="button button--secondary"
          href={sitePath("/docs/concepts/security-model/")}
        >
          Read the security model
        </a>
        <a
          class="button button--quiet"
          href="https://github.com/Jurshsmith/chaft/blob/main/SECURITY.md"
        >
          Read the full policy
        </a>
      </div>
    </div>

    <figure
      class="security-overview__visual"
      aria-labelledby="security-overview-caption"
      data-security-visual
    >
      <div class="security-overview__frame">
        <div class="security-overview__visual-head" aria-hidden="true">
          <span>Workspace topology</span>
          <span><i></i> Peer to peer</span>
        </div>
        <Image
          src={securityBoundaryIllustration}
          alt=""
          widths={[320, 480, 660, 720, 1086, 1448]}
          sizes="(max-width: 820px) min(100vw - 2.5rem, 44rem), min(45.75vw, 41.125rem)"
          format="webp"
          quality={88}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption id="security-overview-caption">
          <span>Shielded tile: encrypted message and attachment content.</span>
          <strong>Outer nodes: participating devices.</strong>
        </figcaption>
      </div>
    </figure>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-security-page-hero]").forEach((section) => {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const showSection = () => {
      section.setAttribute("data-security-visible", "");
    };

    const configureMotion = () => {
      if (reducedMotion.matches) {
        section.dataset.securityMotion = "reduced";
        showSection();
        return;
      }

      section.dataset.securityMotion = "entrance";
      section.removeAttribute("data-security-visible");
      requestAnimationFrame(() => requestAnimationFrame(showSection));
    };

    reducedMotion.addEventListener("change", configureMotion);
    configureMotion();
  });
</script>

<style>
  .security-overview {
    position: relative;
    display: grid;
    min-height: 84svh;
    align-items: center;
    overflow: clip;
    padding-block: clamp(5rem, 10vw, 8.5rem);
    border-block: 1px solid var(--border-subtle);
    background:
      radial-gradient(circle at 78% 45%, rgb(75 195 162 / 9%), transparent 31rem),
      var(--surface-ink);
  }

  .security-overview::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgb(255 253 247 / 2.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 253 247 / 2.5%) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
    content: "";
    mask-image: linear-gradient(90deg, transparent, #000 42%, #000);
  }

  .security-overview__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(24rem, 1.22fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .security-overview__copy {
    position: relative;
    z-index: 2;
    max-width: 31rem;
  }

  .security-overview__copy h1 {
    max-width: 12ch;
    margin-block-end: 1.5rem;
    font-size: clamp(2.5rem, 5vw, 4.55rem);
    text-wrap: balance;
  }

  .security-overview__lede {
    max-width: 30rem;
    margin-block-end: 0;
    color: var(--text-soft);
    font-size: clamp(1.02rem, 1.7vw, 1.17rem);
    line-height: 1.6;
  }

  .security-overview__boundary {
    display: grid;
    grid-template-columns: minmax(8.75rem, 0.42fr) minmax(0, 1fr);
    gap: 1rem;
    margin-block: clamp(1.8rem, 4vw, 2.5rem);
    padding-block: 1rem;
    border-block: 1px solid var(--border-subtle);
  }

  .security-overview__boundary span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .security-overview__boundary span::before {
    width: 0.42rem;
    height: 0.42rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--brand-coral);
    content: "";
  }

  .security-overview__boundary p {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .security-overview__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .security-overview__visual {
    position: relative;
    z-index: 1;
    min-width: 0;
    margin: 0;
  }

  .security-overview__frame {
    overflow: hidden;
    border: 1px solid #5b6b65;
    border-radius: clamp(0.9rem, 2vw, 1.35rem);
    background: #f4f1e8;
    color: #17211f;
    box-shadow:
      0 2rem 5rem rgb(0 0 0 / 24%),
      0 0 0 0.55rem rgb(255 253 247 / 3%);
  }

  .security-overview__visual-head,
  .security-overview__frame figcaption {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .security-overview__visual-head {
    border-bottom: 1px solid #d4d0c4;
    color: #5e6965;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .security-overview__visual-head span:last-child {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #34403c;
  }

  .security-overview__visual-head i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #077054;
    box-shadow: 0 0 0 3px rgb(7 112 84 / 12%);
  }

  .security-overview__frame :global(picture),
  .security-overview__frame :global(img) {
    width: 100%;
  }

  .security-overview__frame :global(img) {
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .security-overview__frame figcaption {
    border-top: 1px solid #d4d0c4;
    color: #5e6965;
  }

  .security-overview__frame figcaption strong {
    flex: 0 0 auto;
    color: #077054;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: no-preference) {
    .security-overview[data-security-motion="entrance"] .security-overview__visual {
      transition:
        opacity 520ms ease-out,
        transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .security-overview[data-security-motion="entrance"]:not([data-security-visible]) .security-overview__visual {
      transform: translate3d(0, 0.85rem, 0) scale(0.985);
      opacity: 0;
    }
  }

  @media (max-width: 820px) {
    .security-overview {
      min-height: auto;
    }

    .security-overview__grid {
      grid-template-columns: 1fr;
      gap: clamp(2.75rem, 8vw, 4rem);
    }

    .security-overview__copy {
      max-width: 38rem;
    }

    .security-overview__copy h1 {
      max-width: 14ch;
    }

    .security-overview__visual {
      width: min(100%, 44rem);
      justify-self: center;
    }
  }

  @media (max-width: 520px) {
    .security-overview {
      padding-block: 4.5rem;
    }

    .security-overview__copy h1 {
      font-size: clamp(2.15rem, 11vw, 3rem);
    }

    .security-overview__boundary {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .security-overview__visual-head,
    .security-overview__frame figcaption {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .security-overview__visual-head {
      display: none;
    }

    .security-overview__actions .button:first-child {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .security-overview__copy > *,
    .security-overview__visual {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }
</style>
