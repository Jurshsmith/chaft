---
import {
  currentRelease,
  formatBytes,
  unsignedCanaryWarning,
} from "../../data/releases";
import { buildDownloadPlatforms } from "../../lib/download-options";
import { sitePath } from "../../lib/site-path";
import PlatformIcon from "./PlatformIcon.astro";

const platforms = buildDownloadPlatforms(currentRelease);
const defaultPlatform = platforms[0]?.id ?? "windows";
const hasPublishedDownloads = currentRelease.assets.some(
  (asset) => asset.available,
);
const platformDescriptions = {
  windows: "Portable package for 64-bit Windows.",
  macos: "Choose the build that matches your Mac.",
  linux: "Portable AppImage for 64-bit Linux.",
} as const;
---

<section
  class="section landing-download"
  id="downloads"
  data-download-experience
  data-download-platform={defaultPlatform}
  data-default-platform={defaultPlatform}
>
  <div class="shell landing-download__grid">
    <div class="landing-download__copy" data-download-copy>
      <p class="eyebrow">Desktop canary</p>
      <h2>
        {hasPublishedDownloads
          ? "Download Chaft."
          : "Desktop packages are being prepared."}
      </h2>
      <p class="body-copy">
        {hasPublishedDownloads
          ? "Choose your platform. Full checksums and release evidence are on the download page."
          : "Windows, macOS, and Linux packages will appear after their release evidence is complete."}
      </p>

      <div class="landing-download__status" aria-label="Current desktop release">
        <span class="status">
          {hasPublishedDownloads ? "Unsigned canary" : "Packages pending"}
        </span>
        <span class="mono">v{currentRelease.version}</span>
      </div>

      <a class="landing-download__details" href={sitePath("/download/")}>
        Details and checksums <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="landing-download__selector-wrap" data-download-selector>
      <div class="landing-download__glow" aria-hidden="true"></div>
      <div class="download-selector">
        <div class="download-selector__header">
          <p class="download-selector__title" id="download-platform-label">
            Choose a platform
          </p>
        </div>

        <nav
          class="platform-tabs"
          aria-labelledby="download-platform-label"
          data-platform-tabs
        >
          {platforms.map((platform) => (
            <a
              class="platform-tab"
              id={`download-tab-${platform.id}`}
              href={`#download-panel-${platform.id}`}
              data-platform-tab={platform.id}
            >
              <span class="platform-tab__identity">
                <PlatformIcon platform={platform.id} />
                <span class="platform-tab__label">{platform.label}</span>
              </span>
              <span
                class="platform-tab__detected"
                data-detected-platform={platform.id}
                aria-hidden="true"
                hidden
              >
                Detected
              </span>
              <span class="platform-tab__selected-cue" aria-hidden="true">✓</span>
            </a>
          ))}
        </nav>

        <div class="download-panels">
          {platforms.map((platform) => (
            <section
              class="download-panel"
              id={`download-panel-${platform.id}`}
              data-platform-panel={platform.id}
              data-initial-visible={platform.id === defaultPlatform ? "" : undefined}
            >
              <div class="download-panel__heading">
                <div>
                  <p class="download-panel__platform">{platform.label}</p>
                  <p>{platformDescriptions[platform.id]}</p>
                </div>
              </div>

              {platform.options.length > 1 && (
                <div
                  class="variant-selector"
                  role="group"
                  aria-label={`${platform.label} processor`}
                  data-variant-selector
                >
                  {platform.options.map((option, index) => (
                    <button
                      type="button"
                      aria-controls={`download-artifact-${option.asset.id}`}
                      aria-pressed={index === 0 ? "true" : "false"}
                      data-variant-trigger={option.asset.id}
                    >
                      {option.variantLabel}
                    </button>
                  ))}
                </div>
              )}

              <div class="download-artifacts">
                {platform.options.map((option, optionIndex) => (
                  <article
                    class="download-artifact"
                    id={`download-artifact-${option.asset.id}`}
                    data-download-artifact-panel={option.asset.id}
                    data-initial-visible={optionIndex === 0 ? "" : undefined}
                  >
                    <p class="availability-state">
                      {option.asset.available ? "Package available" : "Package pending"}
                    </p>
                    <dl class="artifact-meta">
                      <div>
                        <dt>Architecture</dt>
                        <dd>{option.asset.arch}</dd>
                      </div>
                      <div>
                        <dt>Format</dt>
                        <dd>{option.formatLabel}</dd>
                      </div>
                      <div>
                        <dt>Size</dt>
                        <dd>{formatBytes(option.asset.sizeBytes)}</dd>
                      </div>
                    </dl>

                    {option.asset.available ? (
                      <a
                        class="download-primary"
                        href={option.asset.url}
                        aria-label={option.accessibleName}
                        data-download-asset={option.asset.id}
                      >
                        <span>Download {option.formatLabel}</span>
                        <span aria-hidden="true">↓</span>
                      </a>
                    ) : (
                      <span class="download-primary download-primary--pending">
                        Package pending
                      </span>
                    )}
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>

        <p class="canary-note">
          <span aria-hidden="true">●</span>
          <span>{unsignedCanaryWarning}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { detectDesktopOperatingSystem } from "../../lib/platform-detection";

  type NavigatorWithUAData = Navigator & {
    userAgentData?: { mobile?: boolean; platform?: string };
  };

  function readPlatformHints() {
    const navigatorWithUAData = navigator as NavigatorWithUAData;
    return {
      ...(navigatorWithUAData.userAgentData?.platform === undefined
        ? {}
        : { userAgentDataPlatform: navigatorWithUAData.userAgentData.platform }),
      ...(navigatorWithUAData.userAgentData?.mobile === undefined
        ? {}
        : { userAgentDataMobile: navigatorWithUAData.userAgentData.mobile }),
      navigatorPlatform: navigator.platform,
      userAgent: navigator.userAgent,
      maxTouchPoints: navigator.maxTouchPoints,
    };
  }

  document.querySelectorAll<HTMLElement>("[data-download-experience]").forEach((root) => {
    const tabs = Array.from(
      root.querySelectorAll<HTMLElement>("[data-platform-tab]"),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>("[data-platform-panel]"),
    );
    const tablist = root.querySelector<HTMLElement>("[data-platform-tabs]");
    const detectedPlatform = detectDesktopOperatingSystem(readPlatformHints());
    const fallbackPlatform = root.dataset.defaultPlatform ?? tabs[0]?.dataset.platformTab;
    const initialPlatform =
      detectedPlatform && tabs.some((tab) => tab.dataset.platformTab === detectedPlatform)
        ? detectedPlatform
        : fallbackPlatform;
    let platformWasManuallySelected = false;

    tablist?.setAttribute("role", "tablist");
    tabs.forEach((tab) => {
      const platform = tab.dataset.platformTab;
      if (!platform) return;
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", `download-panel-${platform}`);
    });
    panels.forEach((panel) => {
      const platform = panel.dataset.platformPanel;
      if (!platform) return;
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", `download-tab-${platform}`);
    });

    const animateElement = (element: HTMLElement) => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      element.removeAttribute("data-entering");
      void element.offsetWidth;
      element.setAttribute("data-entering", "");
      const finish = () => element.removeAttribute("data-entering");
      element.addEventListener("animationend", finish, { once: true });
      window.setTimeout(finish, 320);
    };

    const updateDetectedBadges = (platform: string) => {
      root.querySelectorAll<HTMLElement>("[data-detected-platform]").forEach(
        (badge) => {
          badge.toggleAttribute(
            "hidden",
            detectedPlatform !== platform ||
              badge.dataset.detectedPlatform !== detectedPlatform,
          );
        },
      );
    };

    const selectPlatform = (
      platform: string,
      options: { animate?: boolean; focus?: boolean; manual?: boolean } = {},
    ) => {
      const activePanel = panels.find(
        (panel) => panel.dataset.platformPanel === platform,
      );
      if (!activePanel) return;

      if (options.manual) platformWasManuallySelected = true;
      root.toggleAttribute("data-platform-manual", platformWasManuallySelected);
      root.dataset.downloadPlatform = platform;
      tabs.forEach((tab) => {
        const active = tab.dataset.platformTab === platform;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && options.focus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.toggleAttribute("hidden", panel !== activePanel);
      });
      updateDetectedBadges(platform);
      if (options.animate) animateElement(activePanel);
    };

    const selectVariant = (
      panel: HTMLElement,
      variant: string,
      animate = false,
    ) => {
      const triggers = Array.from(
        panel.querySelectorAll<HTMLButtonElement>("[data-variant-trigger]"),
      );
      const artifacts = Array.from(
        panel.querySelectorAll<HTMLElement>("[data-download-artifact-panel]"),
      );
      const activeArtifact = artifacts.find(
        (artifact) => artifact.dataset.downloadArtifactPanel === variant,
      );
      if (!activeArtifact) return;

      triggers.forEach((trigger) => {
        trigger.setAttribute(
          "aria-pressed",
          String(trigger.dataset.variantTrigger === variant),
        );
      });
      artifacts.forEach((artifact) => {
        artifact.toggleAttribute("hidden", artifact !== activeArtifact);
      });
      if (animate) animateElement(activeArtifact);
    };

    panels.forEach((panel) => {
      const firstVariant = panel.querySelector<HTMLButtonElement>(
        "[data-variant-trigger]",
      )?.dataset.variantTrigger;
      if (firstVariant) selectVariant(panel, firstVariant);

      panel.querySelectorAll<HTMLButtonElement>("[data-variant-trigger]").forEach(
        (trigger) => {
          trigger.addEventListener("click", () => {
            if (trigger.dataset.variantTrigger) {
              selectVariant(panel, trigger.dataset.variantTrigger, true);
            }
          });
        },
      );
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        const platform = tab.dataset.platformTab;
        if (platform) {
          selectPlatform(platform, { animate: true, focus: true, manual: true });
        }
      });

      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;
        event.preventDefault();
        const platform = tabs[nextIndex]?.dataset.platformTab;
        if (platform) {
          selectPlatform(platform, { animate: true, focus: true, manual: true });
        }
      });
    });

    if (initialPlatform) selectPlatform(initialPlatform);
    root.dataset.enhanced = "";
    if (detectedPlatform) root.dataset.detectedPlatform = detectedPlatform;
  });
</script>

<style>
  .landing-download {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-base);
  }

  .landing-download__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(32rem, 3fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .landing-download__copy {
    max-width: 31rem;
  }

  h2 {
    max-width: 10ch;
    margin-bottom: 1.25rem;
    font-size: clamp(2.75rem, 5vw, 4.75rem);
  }

  .landing-download__status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    align-items: center;
    margin-top: 1.65rem;
  }

  .landing-download__status .mono {
    color: var(--text-faint);
    font-size: 0.72rem;
  }

  .landing-download__details {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 1.25rem;
    color: var(--text-soft);
    font-size: 0.86rem;
    text-decoration: none;
  }

  .landing-download__details:hover {
    color: var(--accent);
  }

  .landing-download__selector-wrap {
    position: relative;
    min-width: 0;
  }

  .landing-download__glow {
    position: absolute;
    inset: 12% -6% 8% 10%;
    border-radius: 42%;
    background: rgb(75 195 162 / 8%);
    filter: blur(48px);
    pointer-events: none;
  }

  .download-selector {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-raised) 96%, var(--secure-surface));
    box-shadow: var(--shadow-lift);
  }

  .download-selector__header {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    padding: 1rem clamp(1rem, 3vw, 1.5rem) 0.7rem;
  }

  .download-selector__title {
    margin: 0;
  }

  .download-selector__title {
    color: var(--text-strong);
    font-size: 1.08rem;
    font-weight: 500;
  }

  .platform-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.4rem, 1.2vw, 0.7rem);
    padding: 0 clamp(1rem, 3vw, 1.5rem) 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .platform-tab {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 4.5rem;
    align-content: center;
    justify-items: center;
    gap: 0.22rem;
    padding: 0.65rem 0.55rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    box-shadow: 0 2px 0 var(--border-subtle);
    color: var(--text-soft);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--motion-quick),
      border-color var(--motion-quick),
      box-shadow var(--motion-quick),
      color var(--motion-quick),
      transform var(--motion-quick);
  }

  .platform-tab__identity {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
  }

  .platform-tab[aria-selected="true"] {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow:
      inset 0 0 0 1px var(--on-accent),
      0 2px 0 var(--border-strong);
    color: var(--on-accent);
  }

  .platform-tab__detected {
    padding: 0.08rem 0.3rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .platform-tab__selected-cue {
    position: absolute;
    top: 0.38rem;
    right: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1;
    opacity: 0;
    transform: scale(0.75);
    transition:
      opacity var(--motion-quick),
      transform var(--motion-quick);
  }

  .platform-tab[aria-selected="true"] .platform-tab__selected-cue {
    opacity: 1;
    transform: none;
  }

  .platform-tab:focus-visible {
    z-index: 1;
    outline: 2px solid var(--accent);
    outline-offset: -3px;
    box-shadow: 0 2px 0 var(--border-subtle);
  }

  .platform-tab[aria-selected="true"]:focus-visible {
    outline-color: var(--on-accent);
    box-shadow:
      inset 0 0 0 1px var(--on-accent),
      0 2px 0 var(--border-strong);
  }

  .download-panels,
  .download-panel {
    min-height: 21.5rem;
  }

  .download-panel {
    display: grid;
    align-content: start;
    padding: clamp(1.15rem, 3vw, 1.55rem);
  }

  [data-enhanced] .download-panel {
    display: flex;
    flex-direction: column;
  }

  [data-enhanced] .download-artifacts,
  [data-enhanced] .download-artifact {
    flex: 1;
  }

  [data-enhanced] .download-artifact {
    display: grid;
    grid-template-rows: auto auto minmax(3.2rem, 1fr);
  }

  [data-enhanced] .download-primary {
    align-self: end;
  }

  @media (scripting: enabled) {
    [data-download-experience]:not([data-enhanced])
      [data-platform-panel]:not([data-initial-visible]),
    [data-download-experience]:not([data-enhanced])
      [data-download-artifact-panel]:not([data-initial-visible]) {
      display: none;
    }
  }

  [data-enhanced] [data-platform-panel][hidden],
  [data-enhanced] [data-download-artifact-panel][hidden] {
    display: none;
  }

  .download-panel + .download-panel {
    border-top: 1px solid var(--border-subtle);
  }

  [data-enhanced] .download-panel + .download-panel {
    border-top: 0;
  }

  .download-panel__heading {
    margin-bottom: 1rem;
  }

  .download-panel__heading p {
    margin: 0;
    font-size: 0.82rem;
  }

  .download-panel__platform {
    color: var(--text-strong);
    font-family: var(--font-ui);
    font-size: 1.25rem !important;
    font-weight: 500;
  }

  .variant-selector {
    display: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
    margin-bottom: 1rem;
    padding: 0.3rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface-deep);
  }

  [data-enhanced] .variant-selector {
    display: grid;
  }

  .variant-selector button {
    min-height: 2.75rem;
    padding: 0.6rem 0.75rem;
    border: 0;
    border-radius: calc(var(--radius-sm) - 2px);
    background: transparent;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition:
      background-color var(--motion-quick),
      box-shadow var(--motion-quick),
      color var(--motion-quick);
  }

  .variant-selector button[aria-pressed="true"] {
    background: var(--surface-raised);
    box-shadow: 0 1px 4px rgb(23 33 31 / 9%);
    color: var(--text-strong);
  }

  .variant-selector button:focus-visible {
    outline: 0;
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  .download-artifact + .download-artifact {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  [data-enhanced] .download-artifact + .download-artifact {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .availability-state {
    margin: 0 0 0.45rem;
    color: var(--secure);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .artifact-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 1.1rem;
    border-block: 1px solid var(--border-subtle);
  }

  .artifact-meta div {
    min-width: 0;
    padding: 0.75rem 0.55rem 0.75rem 0;
  }

  .artifact-meta dt,
  .artifact-meta dd {
    margin: 0;
    font-family: var(--font-mono);
    line-height: 1.45;
  }

  .artifact-meta dt {
    color: var(--text-faint);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .artifact-meta dd {
    color: var(--text-soft);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  .download-primary {
    display: flex;
    min-height: 3.2rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--motion-quick);
  }

  .download-primary:hover {
    background: var(--brand-blue);
  }

  .download-primary--pending {
    border-color: var(--border-subtle);
    background: var(--surface-deep);
    color: var(--text-faint);
  }

  .canary-note {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    margin: 0;
    padding: 0.85rem clamp(1.15rem, 3vw, 1.55rem);
    border-top: 1px solid var(--border-subtle);
    color: var(--warning-text);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .canary-note > span:first-child {
    color: var(--brand-coral);
    font-size: 0.65rem;
  }

  [data-entering] {
    animation: download-content-enter 250ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes download-content-enter {
    from {
      transform: translateY(8px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  @media (hover: hover) {
    .platform-tab:hover {
      border-color: var(--border-strong);
      background: var(--surface-active);
      box-shadow: 0 5px 0 var(--border-subtle);
      color: var(--text-strong);
      transform: translateY(-2px);
    }

    .platform-tab[aria-selected="true"]:hover {
      border-color: var(--accent);
      background: var(--accent);
      box-shadow:
        inset 0 0 0 1px var(--on-accent),
        0 4px 0 var(--border-strong);
      color: var(--on-accent);
      transform: translateY(-1px);
    }

    .variant-selector button:hover {
      background: var(--surface-active);
      color: var(--text-strong);
    }

    .variant-selector button[aria-pressed="true"]:hover {
      background: var(--surface-raised);
    }
  }

  @media (max-width: 960px) {
    .landing-download__grid {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .landing-download__copy {
      max-width: 42rem;
    }

    h2 {
      max-width: 12ch;
    }
  }

  @media (max-width: 560px) {
    .platform-tab {
      min-height: 5rem;
      gap: 0.18rem;
      padding: 0.55rem 0.25rem;
      font-size: 0.74rem;
    }

    .platform-tab__identity {
      flex-direction: column;
      gap: 0.25rem;
    }

    .download-panels,
    .download-panel {
      min-height: 23rem;
    }

    .variant-selector {
      grid-template-columns: 1fr;
    }

    .artifact-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-entering] {
      animation: none;
      transform: none;
      opacity: 1;
    }

    .download-primary,
    .platform-tab,
    .platform-tab__selected-cue,
    .variant-selector button {
      transition: none;
    }

    .platform-tab:hover {
      transform: none;
    }
  }
</style>
