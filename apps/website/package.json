{
  "name": "@chaft/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "build:validation": "node scripts/build.mjs --validation",
    "artifact:create": "node scripts/deployment-artifact-cli.mjs create",
    "artifact:verify": "node scripts/deployment-artifact-cli.mjs verify",
    "artifact:install": "node scripts/deployment-artifact-cli.mjs install",
    "artifact:compare": "node scripts/deployment-artifact-cli.mjs compare",
    "deployment:verify-public": "node scripts/verify-public-deployment.mjs",
    "deployment:validate-governance": "node scripts/governance-validation.mjs",
    "preview": "astro preview",
    "check": "pnpm run check:astro && pnpm run check:tsgo",
    "check:astro": "astro check",
    "check:tsgo": "astro sync && node node_modules/@typescript/native/bin/tsc --project tsconfig.tsgo.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:docs": "node scripts/docs-validation.mjs",
    "validate:docs-build": "node scripts/docs-build-validation.mjs",
    "validate:wrangler": "wrangler deploy --config wrangler.jsonc --dry-run --strict --outdir .wrangler/dry-run",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.3",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
