{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chaft-website",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "chaft.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.chaft.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false
  }
}
