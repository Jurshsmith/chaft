#include <windows.h>

#define IDI_CHAFT_ICON 101

IDI_CHAFT_ICON ICON "@CMAKE_CURRENT_BINARY_DIR@/chaft.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Chaft\0"
      VALUE "FileDescription", "Chaft Desktop\0"
      VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
      VALUE "InternalName", "ChaftDesktop\0"
      VALUE "LegalCopyright", "Copyright Chaft contributors\0"
      VALUE "OriginalFilename", "ChaftDesktop.exe\0"
      VALUE "ProductName", "Chaft\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
